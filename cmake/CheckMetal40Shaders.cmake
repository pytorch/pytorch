cmake_minimum_required(VERSION 3.27 FATAL_ERROR)
foreach(SHADER ${SHADERS})
    cmake_path(GET SHADER STEM TGT_STEM)
    if(TGT_STEM IN_LIST METAL_40_SHADERS)
        continue()
    endif()
    file(STRINGS ${SHADER} SHADER_HEADERS REGEX "^#include <ATen/native/mps/kernels/.*>")
    list(TRANSFORM SHADER_HEADERS REPLACE "^#include <(.*)>.*$" "${SOURCE_DIR}/aten/src/\\1")
    foreach(SRC ${SHADER} ${SHADER_HEADERS})
        file(STRINGS ${SRC} MPP_LINES REGEX "C10_METAL_HAS_MPP")
        if(MPP_LINES)
            message(FATAL_ERROR "${SHADER} has kernels that only build with Metal 4.0, add ${TGT_STEM} to METAL_40_SHADERS")
        endif()
    endforeach()
endforeach()
file(TOUCH ${STAMP})
