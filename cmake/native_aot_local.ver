/* Localize the native-AOT kernel objects' entry points.
 *
 * CuTeDSL's export_to_c emits _mlir_<prefix>_* symbols with default
 * visibility, and those objects are linked straight into torch_cuda
 * (caffe2/CMakeLists.txt), so without this they would become part of
 * torch_cuda's public ABI -- hundreds of names with no stability
 * guarantee, tied to the DSL's codegen. The generated launchers are the
 * only callers and live in the same link, so localizing costs nothing.
 *
 * `local:` here does not restrict anything else: with no matching
 * `global:` pattern the linker keeps its default (export everything not
 * named local), so torch_cuda's real ABI is untouched.
 */
{
  local:
    /* Two spellings: the DSL emits both a bare _mlir_<prefix>_* form and
     * a prefix-first <prefix>__mlir_ciface_* form. */
    _mlir_*;
    *__mlir_ciface_*;
    *_cuda_init;
    *_cuda_load;
    *_cuda_load_to_device;
    *_cuda_num_binaries;
};
