@@ -126,0 +135,36 @@ def test_grouped_main_n64_vendor_configs(m, tile_m, cluster_m, persistent):
+def test_fragment_group4_stores_uint8():
+    """A widened epilogue tile keeps contracted byte stores TMA-legal."""
+
+    @cute.jit
+    def sum4_uint8(acc):
+        group = 4
+        fragment_group = cutlass.const_expr(min(group, cute.size(acc.shape, mode=[0])))
+        repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // fragment_group)
+        grouped = acc.reshape(((1, fragment_group, repeats), 1, 1))
+        value = (
+            grouped[((0, 0, None), None, None)]
+            + grouped[((0, 1, None), None, None)]
+            + grouped[((0, 2, None), None, None)]
+            + grouped[((0, 3, None), None, None)]
+        )
+        return {"main": value.to(cutlass.Uint8)}
+
+    m, n, k = 128, 256, 128
+    A = torch.eye(m, k, device="cuda", dtype=torch.bfloat16)
+    B = (torch.arange(n, device="cuda") % 16).expand(k, n).to(torch.bfloat16)
+    out = torch.empty((m, n // 4), device="cuda", dtype=torch.uint8)
+    mod = fragment_epilogue(outputs=(GroupedMainStore("main", 4),))(sum4_uint8)
+
+    result = mod(
+        A,
+        B,
+        out={"main": out},
+        store_d=False,
+        tuned=False,
+        config_constraints={"tile_n": 256, "swap_ab": False, "cluster_n": 1},
+    )["main"]
+    reference = (A.float() @ B.float()).reshape(m, n // 4, 4).sum(-1).to(torch.uint8)
+    assert result is out
+    assert torch.equal(result, reference)
+
+
