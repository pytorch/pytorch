+        return (self.group, self.paired, self.min_fragment_n, *super().config_key())
@@ -1246,0 +1254,9 @@ class GroupedMainStore(TileStore):
+    def min_epi_tile_n(self, arg_tensor):
+        """Keep stores vectorizable and fragment reductions complete."""
+        store_width = 0
