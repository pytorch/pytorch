@@ -951,0 +952,4 @@ class TileStore(EpiOp):
+    def min_epi_tile_n(self, arg_tensor):
+        """Return a physical-N lower bound imposed by this store, if any."""
+        return None
+
@@ -1177 +1181 @@ class GroupedMainStore(TileStore):
-    def __init__(self, name, group, paired=False):
+    def __init__(self, name, group, paired=False, min_fragment_n=None):
@@ -1181,0 +1186,2 @@ class GroupedMainStore(TileStore):
+        if min_fragment_n is not None and (min_fragment_n <= 0 or min_fragment_n % group):
