@@ -973,0 +1004,82 @@ def _fragment_prepass_mod(group, combine, finalize=None):
+def test_fragment_pair_domain_reduce_feeds_main():
+    """One complete logical group reduces and feeds main in one fragment."""
+    group = 32
+
+    @cute.jit
+    def pair_reduce(acc):
+        pair_width = cutlass.const_expr(min(2, cute.size(acc.shape, mode=[0])))
+        pair_repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // pair_width)
+        paired = acc.reshape(((1, pair_width, pair_repeats), 1, 1))
+        value = paired[((0, 0, None), None, None)] * paired[((0, 1, None), None, None)]
+        group_width = cutlass.const_expr(min(group, cute.size(value.shape, mode=[0])))
+        repeats = cutlass.const_expr(cute.size(value.shape, mode=[0]) // group_width)
+        grouped = value.reshape(((1, group_width, repeats), 1, 1))
+        reduced = grouped.reduce(
+            cute.ReductionOp.MAX,
+            init_val=float("-inf"),
+            reduction_profile=((None, 1, None), 1, 1),
+        )
+        broadcast = reduced.reshape(((1, 1, repeats), 1, 1)).broadcast_to(grouped.shape)
+        return {"main": grouped / (broadcast + cute.full_like(broadcast, 1)), "g": broadcast}
+
+    reduce_op = GroupedLocalReduce(
+        "g",
+        axis=1,
+        group=group,
+        combine="max",
+        fragment_reduced=True,
+        physical_span=2,
+    )
+    mod = fragment_epilogue(
+        outputs=(GroupedMainStore("main", 2, min_fragment_n=2 * group),),
+        outs={"g": reduce_op},
+    )(pair_reduce)
+
+    m, n, k = 128, 256, 128
+    torch.manual_seed(43)
+    A = torch.rand((m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.rand((k, n), device="cuda", dtype=torch.bfloat16)
+    main = torch.empty((m, n // 2), device="cuda", dtype=torch.float32)
+    grouped_out = torch.empty((m, n // (2 * group)), device="cuda", dtype=torch.float32)
+    result = mod(
+        A,
+        B,
+        out={"main": main},
+        store_d=False,
+        tuned=False,
+        g=grouped_out,
+        config_constraints={"tile_n": 256, "swap_ab": False, "cluster_n": 1},
+    )
+
+    value = (A.float() @ B.float()).reshape(m, n // 2, 2).prod(-1)
+    grouped = value.reshape(m, -1, group)
+    reduced = grouped.amax(-1)
+    torch.testing.assert_close(result["main"], (grouped / (reduced[..., None] + 1)).flatten(1))
+    torch.testing.assert_close(grouped_out, reduced)
+
+    unsafe = fragment_epilogue(
+        outputs=(GroupedMainStore("main", 2),),
+        outs={
+            "g": GroupedLocalReduce(
+                "g",
+                axis=1,
+                group=group,
+                combine="max",
+                fragment_reduced=True,
+                physical_span=2,
+            )
+        },
+    )(pair_reduce)
+    unsafe_main = torch.empty((m, n // 2), device="cuda", dtype=torch.float8_e4m3fn)
+    with pytest.raises(Exception, match="logical groups must fit one epilogue fragment"):
+        unsafe(
+            A,
+            B,
+            out={"main": unsafe_main},
+            store_d=False,
+            tuned=False,
+            g=grouped_out,
+            config_constraints={"tile_n": 256, "swap_ab": False, "cluster_n": 1},
+        )
