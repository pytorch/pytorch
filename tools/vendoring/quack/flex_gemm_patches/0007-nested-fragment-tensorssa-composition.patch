@@ -115,0 +124,38 @@ def test_grouped_main_n64_vendor_configs(m, tile_m, cluster_m, persistent):
+
+
+def test_fragment_group4_stores_uint8():
+    """A widened epilogue tile keeps contracted byte stores TMA-legal."""
+
+    @cute.jit
+    def sum4_uint8(acc):
+        group = 4
+        fragment_group = cutlass.const_expr(min(group, cute.size(acc.shape, mode=[0])))
+        repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // fragment_group)
+        grouped = acc.reshape(((1, fragment_group, repeats), 1, 1))
+        value = (
+            grouped[((0, 0, None), None, None)]
+            + grouped[((0, 1, None), None, None)]
+            + grouped[((0, 2, None), None, None)]
+            + grouped[((0, 3, None), None, None)]
+        )
+        return {"main": value.to(cutlass.Uint8)}
+
+    m, n, k = 128, 256, 128
+    A = torch.eye(m, k, device="cuda", dtype=torch.bfloat16)
+    B = (torch.arange(n, device="cuda") % 16).expand(k, n).to(torch.bfloat16)
+    out = torch.empty((m, n // 4), device="cuda", dtype=torch.uint8)
+    mod = fragment_epilogue(outputs=(GroupedMainStore("main", 4),))(sum4_uint8)
+
+    config = GemmConfig(
+        tile_m=128,
+        tile_n=256,
+        cluster_m=1,
+        cluster_n=1,
+        pingpong=False,
+        swap_ab=False,
+        device_capacity=10,
+    )
+    result = mod(A, B, out={"main": out}, store_d=False, tuned=False, config=config)["main"]
+    reference = (A.float() @ B.float()).reshape(m, n // 4, 4).sum(-1).to(torch.uint8)
+    assert result is out
+    assert torch.equal(result, reference)
diff --git a/tests/test_grouped_reduce.py b/tests/test_grouped_reduce.py
index 07a4920..4268648 100644
--- a/tests/test_grouped_reduce.py
+++ b/tests/test_grouped_reduce.py
@@ -29 +29 @@ from quack import epi_math
-from quack.epilogue.frontend import gemm_epilogue, fragment_epilogue
+from quack.epilogue.frontend import fragment_epilogue, gemm_epilogue
@@ -30,0 +31,2 @@ from quack.epilogue.mixin import ComposableEpiMixin
+from quack.gemm_config import GemmConfig
+from quack.epilogue.ops import GroupedMainStore
@@ -959,0 +962,56 @@ def _fragment_prepass_mod(group, combine, finalize=None):
+def test_fragment_pair_domain_reduce_feeds_main():
+    """One complete logical group reduces and feeds main in one fragment."""
+    group = 32
+
+    @cute.jit
+    def pair_reduce(acc):
+        pair_width = cutlass.const_expr(min(2, cute.size(acc.shape, mode=[0])))
+        pair_repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // pair_width)
+        paired = acc.reshape(((1, pair_width, pair_repeats), 1, 1))
+        value = paired[((0, 0, None), None, None)] * paired[((0, 1, None), None, None)]
+        group_width = cutlass.const_expr(min(group, cute.size(value.shape, mode=[0])))
+        repeats = cutlass.const_expr(cute.size(value.shape, mode=[0]) // group_width)
+        grouped = value.reshape(((1, group_width, repeats), 1, 1))
+        reduced = grouped.reduce(
+            cute.ReductionOp.MAX,
+            init_val=float("-inf"),
+            reduction_profile=((None, 1, None), 1, 1),
+        )
+        broadcast = reduced.reshape(((1, 1, repeats), 1, 1)).broadcast_to(grouped.shape)
+        physical = reduced.reshape(((1, 1, repeats), 1, 1)).broadcast_to(
+            ((1, 2 * group_width, repeats), 1, 1)
+        )
+        return {"main": grouped / (broadcast + cute.full_like(broadcast, 1)), "g": physical}
+
+    reduce_op = GroupedLocalReduce(
+        "g", axis=1, group=2 * group, combine="max", fragment_reduced=True
+    )
+    mod = fragment_epilogue(
+        outputs=(GroupedMainStore("main", 2, min_fragment_n=2 * group),),
+        outs={"g": reduce_op},
+    )(pair_reduce)
+
+    m, n, k = 128, 256, 128
+    torch.manual_seed(43)
+    A = torch.rand((m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.rand((k, n), device="cuda", dtype=torch.bfloat16)
+    main = torch.empty((m, n // 2), device="cuda", dtype=torch.float32)
+    grouped_out = torch.empty((m, n // (2 * group)), device="cuda", dtype=torch.float32)
+    config = GemmConfig(
+        tile_m=128,
+        tile_n=256,
+        cluster_m=1,
+        cluster_n=1,
+        pingpong=False,
+        swap_ab=False,
+        device_capacity=10,
+    )
+    result = mod(A, B, out={"main": main}, store_d=False, tuned=False, g=grouped_out, config=config)
+
+    value = (A.float() @ B.float()).reshape(m, n // 2, 2).prod(-1)
+    grouped = value.reshape(m, -1, group)
+    reduced = grouped.amax(-1)
+    torch.testing.assert_close(result["main"], (grouped / (reduced[..., None] + 1)).flatten(1))
+    torch.testing.assert_close(grouped_out, reduced)
+
+
