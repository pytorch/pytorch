+"""Grouped-main output coverage for the direct TensorSSA epilogue frontend."""
+
+from types import SimpleNamespace
+
+import cutlass
+import cutlass.cute as cute
+import pytest
+import torch
+
+from quack import epi_math
+from quack.epilogue.frontend import gemm_epilogue, fragment_epilogue
+from quack.epilogue.ops import GroupedMainStore
+
+
+@cute.jit
+def grouped_main_sum2(acc):
+    """Contract adjacent accumulator pairs into one logical output value."""
+    group = 2
+    fragment_group = cutlass.const_expr(min(group, cute.size(acc.shape, mode=[0])))
+    repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // fragment_group)
+    grouped = acc.reshape(((1, fragment_group, repeats), 1, 1))
+    return {"main": grouped[((0, 0, None), None, None)] + grouped[((0, 1, None), None, None)]}
+
+
+@cute.jit
+def grouped_main_sum4(acc):
+    """Contract adjacent groups of four into one logical output value."""
+    group = 4
+    fragment_group = cutlass.const_expr(min(group, cute.size(acc.shape, mode=[0])))
+    repeats = cutlass.const_expr(cute.size(acc.shape, mode=[0]) // fragment_group)
+    grouped = acc.reshape(((1, fragment_group, repeats), 1, 1))
+    return {
+        "main": grouped[((0, 0, None), None, None)]
+        + grouped[((0, 1, None), None, None)]
+        + grouped[((0, 2, None), None, None)]
+        + grouped[((0, 3, None), None, None)]
+    }
+
+
+def test_grouped_main_store_shape_identity_and_config_legality():
+    group2 = GroupedMainStore("main", 2)
+    group4 = GroupedMainStore("main", 4)
+    assert group2.output_n(256) == 128
+    assert group2.cache_key() != group4.cache_key()
+    with pytest.raises(ValueError, match="divisible by 4"):
+        group4.output_n(258)
+
+    safe = SimpleNamespace(
+        device_capacity=10,
+        tile_m=128,
+        tile_n=128,
+        cluster_m=1,
+        cluster_n=1,
+        swap_ab=False,
+    )
+    assert group2.supports_config(safe)
+    assert group4.supports_config(safe)
+    assert group4.supports_problem(safe, 128, 256)
+
+    n64 = SimpleNamespace(**{**vars(safe), "tile_n": 64})
+    assert group2.supports_config(n64)
+    assert not group4.supports_config(n64)
+    assert not group2.supports_config(SimpleNamespace(**{**vars(safe), "swap_ab": True}))
+    assert not group4.supports_config(SimpleNamespace(**{**vars(safe), "device_capacity": 11}))
+    assert not group2.supports_config(SimpleNamespace(**{**vars(safe), "tile_m": 64, "tile_n": 64}))
+    assert not group2.supports_problem(safe, 128, 64)
+
+
+@pytest.mark.parametrize(
+    ("group", "fn"),
+    ((2, grouped_main_sum2), (4, grouped_main_sum4)),
+)
+def test_fragment_epilogue_grouped_main_matches_reference(group, fn):
+    torch.manual_seed(group)
+    m, n, k = 128, 256, 128
+    A = torch.randn((m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.randn((k, n), device="cuda", dtype=torch.bfloat16)
+    mod = fragment_epilogue(outputs=(GroupedMainStore("main", group),))(fn)
+
+    result = mod(
+        A,
+        B,
+        store_d=False,
+        tuned=False,
+        config_constraints={"swap_ab": False, "cluster_n": 1},
+    )["main"]
+    reference = (A.float() @ B.float()).reshape(m, n // group, group).sum(dim=-1)
+
+    assert result.shape == reference.shape
+    torch.testing.assert_close(result.float(), reference, atol=0.08, rtol=0.02)
+
+
+@pytest.mark.parametrize(
+    ("m", "tile_m", "cluster_m", "persistent"),
+    (
+        (1, 128, 1, True),
+        (17, 128, 1, False),
+        (256, 256, 2, False),
+    ),
+)
+def test_grouped_main_n64_vendor_configs(m, tile_m, cluster_m, persistent):
+    """Modern grouped stores retain the vendor-winning sparse N64 frontier."""
+    torch.manual_seed(m)
+    n, k = 256, 128
+    A = torch.randn((m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.randn((k, n), device="cuda", dtype=torch.bfloat16)
+    mod = fragment_epilogue(outputs=(GroupedMainStore("main", 2),))(grouped_main_sum2)
+
+    result = mod(
+        A,
+        B,
+        store_d=False,
+        tuned=False,
+        config_constraints={
+            "tile_m": tile_m,
+            "tile_n": 64,
+            "cluster_m": cluster_m,
+            "cluster_n": 1,
+            "is_dynamic_persistent": persistent,
+            "swap_ab": False,
+        },
+    )["main"]
+    reference = (A.float() @ B.float()).reshape(m, n // 2, 2).sum(dim=-1)
+    torch.testing.assert_close(result.float(), reference, atol=0.08, rtol=0.02)
+
+
+def test_paired_grouped_main_stores_packed_uint8():
+    """Scalar pair mode can store one packed byte for each adjacent-N pair."""
+
+    @gemm_epilogue(
+        outputs=(GroupedMainStore("main", 2, paired=True),),
+        mode="acc_pair",
+        vectorize=False,
+    )
+    def pack_main(acc):
+        return {"main": epi_math.nvfp4_pack(acc)}
+
+    m, n, k = 128, 256, 128
+    A = torch.eye(m, k, device="cuda", dtype=torch.bfloat16)
+    B = torch.randn(k, n, device="cuda", dtype=torch.bfloat16)
+    result = pack_main(
+        A,
+        B,
+        store_d=False,
+        out_dtype=torch.uint8,
+        tuned=False,
+        config_constraints={"swap_ab": False, "cluster_n": 1},
+    )["main"]
+    values = B.float().view(m, -1, 2)
+    magnitude = values.abs()
+    codes = torch.where(magnitude > 0.25, 1, 0)
+    codes = torch.where(magnitude >= 0.75, 2, codes)
+    codes = torch.where(magnitude > 1.25, 3, codes)
+    codes = torch.where(magnitude >= 1.75, 4, codes)
+    codes = torch.where(magnitude > 2.5, 5, codes)
+    codes = torch.where(magnitude >= 3.5, 6, codes)
+    codes = torch.where(magnitude > 5.0, 7, codes)
+    codes = codes.to(torch.uint8) + (values < 0).to(torch.uint8) * 8
+    reference = codes[..., 0] | (codes[..., 1] << 4)
+    mismatch = result != reference
+    assert not mismatch.any(), (
+        mismatch.sum().item(),
+        result[mismatch][:16],
+        reference[mismatch][:16],
+    )
