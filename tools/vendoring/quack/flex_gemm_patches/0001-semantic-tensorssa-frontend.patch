+"""CUDA numerical coverage for tuple-polymorphic EpiMod pointwise math."""
+
+import pytest
+import torch
+from cutlass import Float16, Float32
+
+from quack import epi_math
+from quack.epilogue.frontend import gemm_epilogue
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA is required")
+
+
+def _transcendentals(x):
+    return epi_math.log1p(epi_math.exp(epi_math.tanh(x))) + epi_math.erf(x)
+
+
+def _roots_and_log(x):
+    positive = x * x + 1.0
+    return (
+        epi_math.reciprocal(epi_math.sqrt(positive))
+        + epi_math.rsqrt(positive)
+        + epi_math.log(positive)
+    )
+
+
+def _activations(x):
+    return epi_math.abs(x) + epi_math.relu(x) + epi_math.sigmoid(x)
+
+
+def _fast_math(x):
+    positive = x * x + 1.0
+    return (
+        epi_math.tanh(x, fast=True)
+        + epi_math.sigmoid(x, fast=True)
+        + epi_math.rsqrt(positive, fast=True)
+    )
+
+
+def _bounds_and_selects(x):
+    eq = epi_math.where(epi_math.eq(x, x), x, -x)
+    ne = epi_math.where(epi_math.ne(x, x), -x, x)
+    le = epi_math.where(epi_math.le(x, 0.0), x, -x)
+    gt = epi_math.where(epi_math.gt(x, 0.0), x, -x)
+    ge = epi_math.select(epi_math.ge(x, 0.0), x, -x)
+    bounded = epi_math.clamp_max(
+        epi_math.clamp_min(epi_math.max(epi_math.min(eq + ne + le + gt + ge, 1.5), -1.5), -1.0),
+        1.0,
+    )
+    return epi_math.clamp(bounded, min=-1.0, max=1.0) + epi_math.where(
+        epi_math.logical_not(epi_math.lt(x, 0.0)), 0.25, -0.25
+    )
+
+
+def _casts(x):
+    return epi_math.store_cast(epi_math.convert_element_type(x, Float16), Float32)
+
+
+def _torch_dtype_casts(x):
+    return epi_math.to_dtype(epi_math.to_dtype(x, torch.float16), torch.float32)
+
+
+PROGRAMS = (
+    (
+        "transcendentals",
+        _transcendentals,
+        lambda x: torch.log1p(torch.exp(torch.tanh(x))) + torch.erf(x),
+        2e-2,
+    ),
+    (
+        "roots_and_log",
+        _roots_and_log,
+        lambda x: 2.0 * torch.rsqrt(x * x + 1.0) + torch.log(x * x + 1.0),
+        2e-2,
+    ),
+    (
+        "activations",
+        _activations,
+        lambda x: x.abs() + torch.relu(x) + torch.sigmoid(x),
+        2e-2,
+    ),
+    (
+        "fast_math",
+        _fast_math,
+        lambda x: torch.tanh(x) + torch.sigmoid(x) + torch.rsqrt(x * x + 1.0),
+        6e-2,
+    ),
+    (
+        "bounds_and_selects",
+        _bounds_and_selects,
+        lambda x: (
+            torch.clamp(
+                torch.maximum(
+                    torch.minimum(
+                        x
+                        + x
+                        + torch.where(x <= 0, x, -x)
+                        + torch.where(x > 0, x, -x)
+                        + torch.where(x >= 0, x, -x),
+                        torch.tensor(1.5, device=x.device),
+                    ),
+                    torch.tensor(-1.5, device=x.device),
+                ),
+                min=-1.0,
+                max=1.0,
+            )
+            + torch.where(torch.logical_not(x < 0), 0.25, -0.25)
+        ),
+        2e-2,
+    ),
+    ("casts", _casts, lambda x: x.to(torch.float16).float(), 2e-2),
+    (
+        "torch_dtype_casts",
+        _torch_dtype_casts,
+        lambda x: x.to(torch.float16).float(),
+        2e-2,
+    ),
+)
+
+
+def _make_epilogue(program, mode):
+    @gemm_epilogue(mode=mode, vectorize=False)
+    def epilogue(acc):
+        return {"D": program(acc)}
+
+    return epilogue
+
+
+@pytest.mark.parametrize("mode", ("element", "acc_pair"))
+@pytest.mark.parametrize("_name,program,reference,rtol", PROGRAMS)
+def test_epi_math(_name, program, reference, rtol, mode):
+    """Every helper runs through scalar and paired EpiMod accumulator paths."""
+    torch.manual_seed(0)
+    m = n = k = 128
+    a = torch.randn((1, m, k), device="cuda", dtype=torch.bfloat16) / k**0.5
+    b = torch.randn((1, n, k), device="cuda", dtype=torch.bfloat16) / k**0.5
+    out = torch.empty((1, m, n), device="cuda", dtype=torch.bfloat16)
+
+    _make_epilogue(program, mode).gemm(
+        a,
+        b,
+        out,
+        epi_args={},
+        tile_M=128,
+        tile_N=128,
+        cluster_M=1,
+        cluster_N=1,
+    )
+
+    acc = torch.einsum("lmk,lnk->lmn", a.float(), b.float())
+    torch.testing.assert_close(out.float(), reference(acc), rtol=rtol, atol=2e-2)
