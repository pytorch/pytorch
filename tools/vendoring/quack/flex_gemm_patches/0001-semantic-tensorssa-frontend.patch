@@ -0,0 +1,92 @@
+"""Numeric contracts for quantization helpers used by generated EpiMods."""
+
+import torch
+
+from quack import epi_math
+from quack.epilogue.frontend import gemm_epilogue
+
+
+@gemm_epilogue(outputs=("scale",))
+def mx_rceil_epi(acc):
+    """Encode each accumulator value with the MX RCEIL recipe."""
+    return {"scale": epi_math.mx_e8m0_scale(acc, 448.0, "rceil")}
+
+
+@gemm_epilogue(outputs=("scale",))
+def mx_floor_epi(acc):
+    """Encode each accumulator value with the MX FLOOR recipe."""
+    return {"scale": epi_math.mx_e8m0_scale(acc, 448.0, "floor")}
+
+
+@gemm_epilogue(outputs=("scale",))
+def nvfp4_scale_epi(acc):
+    """Encode each accumulator value with the NVFP4 E4M3 scale recipe."""
+    return {"scale": epi_math.nvfp4_e4m3_scale(acc, 6.0, "nearest")}
+
+
+def mx_reference(values, rounding):
+    """Return the eager E8M0 byte encoding for one MX rounding recipe."""
+    values = values.float()
+    if rounding == "floor":
+        extracted = ((values.view(torch.int32) >> 23) & 0xFF) - 127
+        encoded = (torch.clamp(extracted - 8, min=-127, max=128) + 127).to(torch.uint8)
+        return torch.where(torch.isnan(values), torch.full_like(encoded, 255), encoded)
+    descale = values / 448.0
+    bits = descale.view(torch.int32)
+    exponent = (bits >> 23) & 0xFF
+    mantissa = bits & 0x7FFFFF
+    encoded = exponent + (mantissa != 0).to(torch.int32)
+    encoded = torch.where(
+        (exponent == 0) & (mantissa <= 0x400000),
+        torch.zeros_like(encoded),
+        encoded,
+    )
+    encoded = torch.clamp(encoded, max=254).to(torch.uint8)
+    return torch.where(torch.isnan(descale), torch.full_like(encoded, 255), encoded)
+
+
+def run_scale_mod(mod, values, dtype):
+    """Run one scale EpiMod on exactly representable GEMM values."""
+    m, logical_n, n, k = 128, values.numel(), max(16, values.numel()), 8
+    A = torch.zeros((m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.zeros((k, n), device="cuda", dtype=torch.bfloat16)
+    A[:, 0] = 1
+    B[0, :logical_n] = values.to(device="cuda", dtype=torch.bfloat16)
+    out = torch.empty((m, n), device="cuda", dtype=dtype)
+    result = mod(A, B, out={"scale": out}, store_d=False, tuned=False)["scale"]
+    return result[:, :logical_n]
+
+
+def test_epi_math_mx_scale_matches_reference_bytes():
+    values = torch.tensor(
+        [
+            0.0,
+            448.0,
+            449.0,
+            500.0,
+            511.0,
+            512.0,
+            float("inf"),
+            float("nan"),
+        ],
+        dtype=torch.float32,
+    )
+    for rounding, mod in (("rceil", mx_rceil_epi), ("floor", mx_floor_epi)):
+        actual = run_scale_mod(mod, values, torch.float8_e8m0fnu)[0].view(torch.uint8)
+        expected = mx_reference(values.to(torch.bfloat16), rounding)
+        torch.testing.assert_close(actual.cpu(), expected)
+
+
+def test_epi_math_nvfp4_scale_matches_reference_bytes():
+    values = torch.tensor(
+        [0.0, 0.09375, 1.0, 6.0, 7.0, 2688.0, float("inf"), float("nan")],
+        dtype=torch.float32,
+    )
+    actual = run_scale_mod(nvfp4_scale_epi, values, torch.float8_e4m3fn)[0].view(torch.uint8)
+    expected = torch.clamp(
+        values.to(torch.bfloat16).float() / 6.0,
+        min=torch.finfo(torch.float8_e4m3fn).tiny,
+        max=torch.finfo(torch.float8_e4m3fn).max,
+    ).to(torch.float8_e4m3fn)
+    torch.testing.assert_close(actual[:-1].cpu(), expected.view(torch.uint8)[:-1])
+    assert torch.isnan(actual[-1].view(torch.float8_e4m3fn))
