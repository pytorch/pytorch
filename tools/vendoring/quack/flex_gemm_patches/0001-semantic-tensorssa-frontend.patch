+def test_cache_dir_override_is_nested_and_exception_safe(tmp_path):
+    import quack.cache
+
+    outer = tmp_path / "outer"
+    inner = tmp_path / "inner"
+    original = quack.cache.get_cache_dir()
+    with quack.cache.cache_dir_override(str(outer)):
+        assert quack.cache.get_cache_path() == outer
+        try:
+            with quack.cache.cache_dir_override(str(inner)):
+                assert quack.cache.get_cache_path() == inner
+                raise RuntimeError("probe")
+        except RuntimeError:
+            pass
+        assert quack.cache.get_cache_path() == outer
+    assert quack.cache.get_cache_dir() == original
+
+
