diff --git a/tests/test_grouped_reduce.py b/tests/test_grouped_reduce.py
index 3eab38c..0b32183 100644
--- a/tests/test_grouped_reduce.py
+++ b/tests/test_grouped_reduce.py
@@ -290,0 +291,32 @@ def test_two_argument_finalizer_rejects_swap_ab():
+def test_output_layout_owns_carrier_stride_contract():
+    """Custom callbacks may interpret strides that dense sinks reject."""
+
+    def tensor_fn(tensor, _transposed):
+        return tensor
+
+    def carrier_shape(batch, rows, cols):
+        return (batch, rows, cols)
+
+    layout = GroupedLocalReduceOutputLayout(
+        "strided",
+        tensor_fn,
+        carrier_shape,
+        carrier_shape,
+        3,
+    )
+    op = GroupedLocalReduce("g", axis=1, group=16, output_layout=layout)
+    carrier = torch.empty(1, 4, 8).transpose(-1, -2)
+    assert carrier.shape == (1, 8, 4)
+    assert carrier.stride(-1) != 1
+    assert op.host_arg_key(carrier)[0] is cutlass.Float32
+    op.host_validate(
+        carrier,
+        m=8,
+        n=64,
+        tile_M=128,
+        tile_N=64,
+        batch=None,
+        varlen_m=False,
+    )
+
+
