+    out = _compressed_out(l, m, n, 1, group)
+    grouped_state_store.gemm(A, B, D, epi_args=dict(g=out), **_TILE)
+    grouped = x.unflatten(-1, (n // group, group))
+    _check(D, x, "D")
+    _check(out, (grouped + grouped.square() + grouped.pow(3)).sum(-1), "three-plane state")
