+def test_grouped_store_online_lse_special_values():
+    """Tuple combine preserves PyTorch semantics for infinities and NaNs."""
+    l, m, n, k, group = 1, 4, 512, 16, 128
+    A = torch.ones((l, m, k), device="cuda", dtype=torch.bfloat16)
+    B = torch.zeros((l, n, k), device="cuda", dtype=torch.bfloat16)
+    B[:, :group] = (
+        torch.linspace(-80, 80, group, device="cuda", dtype=torch.bfloat16)[None, :, None] / k
+    )
+    B[:, group : 2 * group] = -torch.inf
+    B[:, 2 * group] = torch.inf
+    B[:, 3 * group] = torch.nan
+    x = torch.einsum("lmk,lnk->lmn", A.float(), B.float())
+    D = torch.empty((l, m, n), device="cuda", dtype=torch.float32)
+    out = _compressed_out(l, m, n, 1, group)
+    _lse_store_mod(group).gemm(A, B, D, epi_args=dict(g=out), **_TILE)
+    torch.testing.assert_close(D, x, equal_nan=True)
+    torch.testing.assert_close(
+        out,
+        x.unflatten(-1, (n // group, group)).logsumexp(-1),
+        atol=2e-3,
+        rtol=2e-3,
+        equal_nan=True,
+    )
