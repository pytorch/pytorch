+"""Tests for quack.grouped_reduce: FlexGEMM-style grouped local reductions.
+
+Two layers:
+
+* host-only: the op configuration contract — fail-closed ``config_key`` (so a
+  different generated combine/finalize can never reuse a cached kernel),
+  compressed-shape validation, and the feed-main capability gate.
+* GPU: numeric checks against a float32 torch reference for every reduction
+  geometry (in-fragment N fold, cross-fragment N combine, row-lane M butterfly,
+  cross-warp M stitch), axis-1 prepass feed-main groups, each combine, ``mean``
+  finalize, ragged tails with dynamic group counts, the 2-CTA epilogue layout,
+  and feed-main broadcasts.
+"""
+
+import math
+import pickle
+from types import SimpleNamespace
+
+import cutlass
+import cutlass.cute as cute
+import pytest
+import torch
+
+from quack.epilogue.frontend import gemm_epilogue, fragment_epilogue
+from quack.epilogue.mixin import ComposableEpiMixin
+from quack.grouped_reduce import (
+    GROUPED_FRAGMENT_WIDTH,
+    Blocked128x4GroupedLocalReduce,
+    GroupedFeedMainMixin,
+    GroupedLocalReduce,
+    GroupedLocalReduceFeed,
+    GroupedLocalReducePrepass,
+    GroupedLocalReduceWithFinalizeArg,
+    blocked_128x4_carrier_view,
+    blocked_128x4_numel,
+    feed_main_capable,
+    grouped_reduce_out_shape,
+    grouped_reduce_supports_config,
+    max_grouped_reduce_group,
+    validate_grouped_reduce_out,
+)
+
+# ---------------------------------------------------------------- host config
+
+
+def test_config_key_covers_geometry_and_combine():
+    """Every static knob that changes generated code changes the cache key."""
+    base = GroupedLocalReduce("g", axis=1, group=32)
+    variants = (
+        base,
+        GroupedLocalReduce("g", axis=1, group=64),
+        GroupedLocalReduce("g", axis=0, group=32),
+        GroupedLocalReduce("g", axis=1, group=32, combine="max"),
+        GroupedLocalReduce("g", axis=1, group=32, combine=None),
+        GroupedLocalReduce("g", axis=1, group=32, finalize="mean"),
+    )
+    assert len({op.cache_key() for op in variants}) == len(variants)
+    assert base.cache_key() == GroupedLocalReduce("g", axis=1, group=32).cache_key()
+    pickle.dumps(tuple(op.cache_key() for op in variants))
+
+
+def test_callable_combine_and_finalize_keys_are_distinct():
+    """Generated callables key by source digest, not by identity or repr."""
+
+    def combine_sum(x, y):
+        return x + y
+
+    def combine_prod(x, y):
+        return x * y
+
+    def finalize_half(value):
+        return value * 0.5
+
+    keys = {
+        GroupedLocalReduce("g", axis=1, group=32, combine=fn, finalize=fin).cache_key()
+        for fn in (combine_sum, combine_prod)
+        for fin in (None, finalize_half)
+    }
+    assert len(keys) == 4
+    pickle.dumps(keys)
+    assert (
+        GroupedLocalReduce("g", axis=1, group=32, combine=combine_sum).cache_key()
+        != GroupedLocalReduce("g", axis=1, group=32, combine="add").cache_key()
+    )
+
+
+def test_config_key_fails_closed_on_unknown_config():
+    """A subclass that adds configuration must extend the key, not alias it."""
+
+    class _ScaledReduce(GroupedLocalReduce):
+        def __init__(self, name, **kwargs):
+            super().__init__(name, **kwargs)
+            self.scale = 2.0
+
+    with pytest.raises(NotImplementedError, match="config_key"):
+        _ScaledReduce("g", axis=1, group=32).config_key()
+
+
+def _grouped_epi_fn(acc):
+    return {"D": acc, "g": acc}
+
+
+def test_epi_mod_digest_tracks_op_config():
+    """The same fn with different reduce config mints a different kernel."""
+    digests = {
+        gemm_epilogue(outs={"g": GroupedLocalReduce("g", **kwargs)})(
+            _grouped_epi_fn
+        ).semantic_digest
+        for kwargs in (
+            dict(axis=1, group=32),
+            dict(axis=1, group=32, combine="max"),
+            dict(axis=1, group=32, finalize="mean"),
+            dict(axis=0, group=32),
+        )
+    }
+    assert len(digests) == 4
+
+
+def test_compressed_shape_and_out_validation():
+    assert grouped_reduce_out_shape(512, 256, 32, axis=1, batch=2) == (2, 512, 8)
+    assert grouped_reduce_out_shape(512, 256, 32, axis=0) == (16, 256)
+    out = torch.empty(2, 512, 8)
+    validate_grouped_reduce_out("g", out, 512, 256, 32, axis=1, batch=2, tile_N=256)
+    with pytest.raises(ValueError, match="must divide the grouped dim"):
+        validate_grouped_reduce_out("g", out, 512, 260, 32, axis=1, batch=2)
+    with pytest.raises(ValueError, match="CTA tile extent"):
+        validate_grouped_reduce_out("g", out, 512, 256, 32, axis=1, batch=2, tile_N=16)
+    with pytest.raises(ValueError, match="compressed shape"):
+        validate_grouped_reduce_out("g", out, 512, 256, 16, axis=1, batch=2)
+    strided = torch.empty(2, 512, 16)[..., ::2]
+    with pytest.raises(ValueError, match="contiguous"):
+        validate_grouped_reduce_out("g", strided, 512, 256, 32, axis=1, batch=2)
+
+
+def test_host_arg_key_rejects_unusable_buffers():
+    op = GroupedLocalReduce("g", axis=1, group=32)
+    assert op.host_arg_key(None) is None
+    with pytest.raises(ValueError, match="rank 2 or 3"):
+        op.host_arg_key(torch.empty(4))
+    with pytest.raises(ValueError, match="contiguous"):
+        op.host_arg_key(torch.empty(8, 4).mT)
+
+
+def test_plain_sink_host_validation():
+    op = GroupedLocalReduce("g", axis=0, group=32)
+    kwargs = {
+        "m": 512,
+        "n": 256,
+        "tile_M": 256,
+        "tile_N": 256,
+        "batch": None,
+        "varlen_m": False,
+    }
+    op.host_validate(torch.empty(16, 256), **kwargs)
+    op.host_validate(torch.empty(4, 16, 256), **{**kwargs, "batch": 4})
+    with pytest.raises(ValueError, match="must divide the grouped dim"):
+        op.host_validate(torch.empty(16, 256), **{**kwargs, "m": 510})
+    with pytest.raises(ValueError, match="expected compressed shape"):
+        op.host_validate(torch.empty(8, 256), **kwargs)
+    with pytest.raises(ValueError, match="expected compressed shape"):
+        op.host_validate(torch.empty(16, 256), **{**kwargs, "batch": 4})
+    with pytest.raises(ValueError, match="do not support varlen_m"):
+        op.host_validate(torch.empty(16, 256), **{**kwargs, "varlen_m": True})
+    with pytest.raises(ValueError, match="do not support varlen_m"):
+        GroupedLocalReduceFeed("g", group=8).host_validate(None, **{**kwargs, "varlen_m": True})
+
+
+def test_two_argument_finalizer_rejects_swap_ab():
+    def finalize(value, scale):
+        return value * scale
+
+    op = GroupedLocalReduceWithFinalizeArg("g", axis=1, group=16, finalize=finalize)
+    assert not op.supports_swap_ab
+
+
+def test_blocked_carrier_contract_and_cache_identity():
+    """Blocked storage owns padding, metadata shape, and semantic identity."""
+    assert blocked_128x4_numel(128, 4) == 512
+    assert blocked_128x4_numel(129, 5, batch=2) == 4096
+    carrier = torch.empty(2048)
+    view = blocked_128x4_carrier_view(carrier, 129, 5)
+    assert view.shape == (1, 129, 5)
+    assert view.stride() == (2048, 0, 0)
+    assert view.untyped_storage().data_ptr() == carrier.untyped_storage().data_ptr()
+
+    op = Blocked128x4GroupedLocalReduce("g", group=16)
+    assert op.host_arg_key(view)[0] is cutlass.Float32
+    assert op.cache_key() != GroupedLocalReduce("g", axis=1, group=16).cache_key()
+    with pytest.raises(NotImplementedError, match="axis 1 only"):
+        Blocked128x4GroupedLocalReduce("g", axis=0, group=16)
+    with pytest.raises(ValueError, match="contiguous rank 1"):
+        blocked_128x4_carrier_view(torch.empty(2049), 129, 5)
+    with pytest.raises(ValueError, match="metadata view"):
+        op.host_arg_key(torch.empty(1, 129, 5))
