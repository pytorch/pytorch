+
+def test_prepass_value_port_config_and_validation():
+    """Axis-1 feed-main is a tensorless prepass sink/value port with keyed semantics."""
+
+    def finalize_half(value):
+        return value * 0.5
+
+    base = GroupedLocalReducePrepass("g", group=16)
+    variants = (
+        base,
+        GroupedLocalReducePrepass("g", group=4),
+        GroupedLocalReducePrepass("g", group=16, combine="max"),
+        GroupedLocalReducePrepass("g", group=16, finalize="mean"),
+        GroupedLocalReducePrepass("g", group=16, finalize=finalize_half),
+    )
+    assert base.fn_port == "value" and base.keep_tensorless
+    assert len({op.cache_key() for op in variants}) == len(variants)
+    assert base.host_arg_key(None) is None
+    with pytest.raises(ValueError, match="tensorless"):
