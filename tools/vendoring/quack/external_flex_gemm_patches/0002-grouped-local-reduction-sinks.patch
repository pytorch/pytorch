+def _store_mod(axis, group, combine, finalize):
+    op = GroupedLocalReduce("g", axis=axis, group=group, combine=combine, finalize=finalize)
+
+    @gemm_epilogue(outs={"g": op})
+    def grouped_store(acc):
+        return {"D": acc, "g": acc}
+
+    return grouped_store
+
+
+def _swap_store_mod(axis, group, combine, finalize):
+    op = GroupedLocalReduce(
+        "g",
+        axis=axis,
+        group=group,
+        combine=combine,
+        finalize=finalize,
+    )
+
+    @fragment_epilogue(outs={"g": op})
+    @cute.jit
+    def grouped_store(acc):
+        return {"D": acc, "g": acc}
+
+    return grouped_store
+
+
+def _blocked_store_mod(group, combine="add", finalize=None):
+    op = Blocked128x4GroupedLocalReduce(
+        "g",
+        group=group,
+        combine=combine,
+        finalize=finalize,
+    )
+
+    @fragment_epilogue(outs={"g": op})
+    @cute.jit
+    def grouped_store(acc):
+        return {"D": acc, "g": acc}
+
+    return grouped_store
+
+
+def _feed_mod(group, combine, finalize):
+    op = GroupedLocalReduceFeed("g", group=group, combine=combine, finalize=finalize)
+
+    @gemm_epilogue(ops={"g": op})
+    def grouped_feed(acc, g):
+        return {"D": acc - g(acc)}
+
+    return grouped_feed
+
+
+def _grouped_prepass(acc):
+    return {"g": acc}
+
+
+def _prepass_mod(group, combine, finalize=None):
+    op = GroupedLocalReducePrepass("g", group=group, combine=combine, finalize=finalize)
+
+    @gemm_epilogue(ops={"g": op}, prepass=_grouped_prepass, prepass_outs=("g",))
+    def grouped_prepass_feed(acc, g):
+        return {"D": acc - g}
+
+    return grouped_prepass_feed
+
+
+def _fragment_prepass_mod(group, combine, finalize=None):
+    op = GroupedLocalReducePrepass("g", group=group, combine=combine, finalize=finalize)
+
+    @fragment_epilogue(ops={"g": op}, prepass=_grouped_prepass, prepass_outs=("g",))
+    @cute.jit
+    def grouped_prepass_feed(acc, g):
+        return {"D": acc - g}
+
+    return grouped_prepass_feed
+
+
+def _inputs(l, m, n, k, seed=0):
+    torch.random.manual_seed(seed)
+    A = torch.randn((l, m, k), device="cuda", dtype=torch.bfloat16) / math.sqrt(k) * 4
+    B = torch.randn((l, n, k), device="cuda", dtype=torch.bfloat16) / math.sqrt(k) * 4
+    return A, B, torch.einsum("lmk,lnk->lmn", A.float(), B.float())
+
+
+def _grouped_ref(x, axis, group, combine, finalize):
+    if axis == 1:
+        grouped, dim = x.unflatten(-1, (x.shape[-1] // group, group)), -1
+    else:
+        grouped, dim = x.unflatten(-2, (x.shape[-2] // group, group)), -2
+    out = {
+        "add": lambda: grouped.sum(dim),
+        "mul": lambda: grouped.prod(dim),
+        "max": lambda: grouped.amax(dim),
+        "min": lambda: grouped.amin(dim),
+    }[combine]()
+    return out / group if finalize == "mean" else out
+
+
+def _check(out, ref, name, tol=2e-2):
+    assert not out.isnan().any(), f"{name}: kernel left elements unwritten"
+    err = (out.float() - ref).abs().max().item()
+    scale = ref.abs().max().item()
+    assert err <= tol * scale + 1e-4, f"{name}: err {err} vs scale {scale}"
+
+
+def _compressed_out(l, m, n, axis, group, dtype=torch.float32):
+    shape = grouped_reduce_out_shape(m, n, group, axis, batch=l)
+    return torch.full(shape, float("nan"), device="cuda", dtype=dtype)
