def _run_flydsl_forward(
    query,
    key,
    value,
    logsumexp,
    max_scores,
    kv_num_blocks,
    kv_indices,
    full_kv_num_blocks,
    full_kv_indices,
{% for name in buffer_args + table_args %}
    {{name}},
{% endfor %}
    output,
    stream,
):
{% if CAPTURE_TABLE %}
    fill_flydsl_capture_table(
        _capture_table_launchers,
        CAPTURE_TABLE_SLOTS,
        capture_table,
        ({% for name in buffer_args %}{{name}}, {% endfor %}),
        stream,
        compiler=flyc.compile,
        tensor_converter={{ "flydsl_runtime_layout_arg" if RUNTIME_SIZES else "flyc.from_torch_tensor" }},
    )
{% endif %}
{% if VALUE_SLICES is defined %}
    for start in range(0, VALUE_SLICES * V_HEAD_DIM, V_HEAD_DIM):
{% endif %}
{% filter indent(4 if VALUE_SLICES is defined else 0, first=True) %}
    dispatch_args = (
        query,
        key,
        {{ "value[..., start : start + V_HEAD_DIM]" if VALUE_SLICES is defined else "value" }},
        logsumexp,
        max_scores,
        kv_num_blocks,
        kv_indices,
        full_kv_num_blocks,
        full_kv_indices,
{% for name in (table_args + extent_args if CAPTURE_TABLE else buffer_args) %}
        {{name}},
{% endfor %}
        {{ "output[..., start : start + V_HEAD_DIM]" if VALUE_SLICES is defined else "output" }},
        stream,
    )
    run_flydsl_template(
        _launcher.get(query.device),
        dispatch_args,
        compiler=flyc.compile,
        tensor_converter={{ "flydsl_runtime_layout_arg" if RUNTIME_SIZES else "flyc.from_torch_tensor" }},
    )
{% endfilter %}
    return output


