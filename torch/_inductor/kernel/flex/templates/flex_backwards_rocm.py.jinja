        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 64) < V_HEAD_DIM), other=0.0)
        {%- elif ROCM_D192_PANEL_DOTS %}
        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 128) < V_HEAD_DIM), other=0.0)
        {%- else %}
        do_lo = tl.load(do_lo_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        {%- endif %}
        do = tl.cat(do_lo, do_hi, dim=1)
{% else %}
{{ default() | indent(4, true) }}
{% endif %}
{% endmacro -%}
{% macro backward_dkdv_updates(default) %}
{% if EARLY_PROBABILITY_COMPACT %}
    if IS_DIVISIBLE:
