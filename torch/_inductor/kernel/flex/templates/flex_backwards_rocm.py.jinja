        offs_m1 = q_start + tl.arange(0, BLOCK_M1)
        dk, dv = bwd_dkdv_all_heads_inner(
            {{gen_argdefs()}},
            Q, DO, DELTA, LSE, q_start,
            dk, dv, k, v,
            off_zq, off_hkv, off_hsplit, offs_n1, offs_m1,
            stride_qz, stride_qh, stride_doz, stride_doh,
            stride_qm, stride_qd, stride_dom, stride_dod,
            q_indices, sparse_q_num_blocks,
            MATMUL_PRECISION,
            IS_FULL_BLOCKS=False,
        )
        if HAS_FULL_BLOCKS:
            sparse_full_q_num_blks_offset = sparse_hz_offset * stride_full_q_num_blks_h + pid_mask
            sparse_full_q_idx_offset = sparse_hz_offset * stride_full_q_idx_h + pid_mask * stride_full_q_idx_n
            q_indices = FULL_Q_IDX + sparse_full_q_idx_offset
            q_start = 0
{% if BLOCKS_ARE_CONTIGUOUS %}
            q_start = tl.load(q_indices) * SPARSE_Q_BLOCK_SIZE
{% endif %}
            sparse_q_num_blocks = tl.load(FULL_Q_NUM_BLKS + sparse_full_q_num_blks_offset)
            offs_m1 = q_start + tl.arange(0, BLOCK_M1)
            dk, dv = bwd_dkdv_all_heads_inner(
                {{gen_argdefs()}},
                Q, DO, DELTA, LSE, q_start,
                dk, dv, k, v,
                off_zq, off_hkv, off_hsplit, offs_n1, offs_m1,
                stride_qz, stride_qh, stride_doz, stride_doh,
                stride_qm, stride_qd, stride_dom, stride_dod,
                q_indices, sparse_q_num_blocks,
                MATMUL_PRECISION,
                IS_FULL_BLOCKS=True,
            )

{% else %}        for off_g in range(0, GQA_SHARED_HEADS // ROCM_GQA_SPLITS):
            off_hq1 = off_hkv * GQA_SHARED_HEADS + off_hsplit * (GQA_SHARED_HEADS // ROCM_GQA_SPLITS) + off_g

            # Offset Q, DQ, DO, DELTA & LSE. These inputs are offsetted by query heads.
            q_adj1 = (stride_qh * off_hq1 + stride_qz * off_zq).to(tl.int64)
            do_adj1 = (stride_doh * off_hq1 + stride_doz * off_zq).to(tl.int64)
            dq_adj1 = (stride_dqh * off_hq1 + stride_dqz * off_zq).to(tl.int64)
            off_chz1 = ((off_zq * HQ + off_hq1) * Q_LEN).to(tl.int64)

            Q1 = Q + q_adj1
            DO1 = DO + do_adj1
            # TODO: This does not work if DQ is not the same layout as Q (for example,
            # if Q is broadcasted)
            LSE1 = LSE + off_chz1
            DELTA1 = DELTA + off_chz1

            sparse_idx_hq1 = off_hq1 % SPARSE_HQ
            sparse_hz_offset = sparse_idx_z * SPARSE_HQ + sparse_idx_hq1

            sparse_q_num_blks_offset = sparse_hz_offset * stride_q_num_blks_h + pid_mask
            sparse_q_idx_offset = sparse_hz_offset * stride_q_idx_h + pid_mask * stride_q_idx_n  # noqa: B950
            {%- if HAS_FULL_BLOCKS %}
            sparse_full_q_num_blks_offset = sparse_hz_offset * stride_full_q_num_blks_h + pid_mask
            sparse_full_q_idx_offset = sparse_hz_offset * stride_full_q_idx_h + pid_mask * stride_full_q_idx_n  # noqa: B950
            {%- endif %}

            # ~~~~~~~~~~~~~~~ fully unmasked blocks ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            # Q_IDX and Q_NUM_BLKS are always contiguous.
            q_indices = Q_IDX + sparse_q_idx_offset
            q_start = tl.load(q_indices) * SPARSE_Q_BLOCK_SIZE # first q block we're loading
            sparse_q_num_blocks = tl.load(Q_NUM_BLKS + sparse_q_num_blks_offset)

            offs_m1 = q_start + tl.arange(0, BLOCK_M1)
            desc_q = None
            desc_do = None
            {%- if USE_TMA %}
            desc_q = tl.make_tensor_descriptor(
                base=Q1,
                shape=(Q_LEN, QK_HEAD_DIM),
                strides=(stride_qm, 1),
                block_shape=[BLOCK_M1, QK_HEAD_DIM_ROUNDED],
            )
            desc_do = tl.make_tensor_descriptor(
                base=DO1,
                shape=(Q_LEN, V_HEAD_DIM),
                strides=(stride_dom, 1),
                block_shape=[BLOCK_M1, V_HEAD_DIM_ROUNDED],
            )
            {%- endif %}
            dk, dv = bwd_dkdv_inner(
                {{gen_argdefs()}},
                Q1, DO1, DELTA1, LSE1,
                desc_q, desc_do, q_start,
                dk, dv, k, v,
                {%- if PANEL_DOTS %}
                k_lo, k_hi, v_lo, v_hi,
                {%- endif %}
                off_zq, off_hq1, offs_n1, offs_m1,
                stride_qm, stride_qd, stride_dom, stride_dod,
                q_indices, sparse_q_num_blocks,
                MATMUL_PRECISION,
                IS_FULL_BLOCKS=False,
            )


            if HAS_FULL_BLOCKS:
                # ~~~~~~~~~~~~~~~ fully unmasked blocks ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                # FULL_Q_IDX and FULL_Q_NUM_BLKS are always contiguous.
                q_indices = FULL_Q_IDX + sparse_full_q_idx_offset
                q_start = tl.load(q_indices) * SPARSE_Q_BLOCK_SIZE # first q block we're loading
                sparse_q_num_blocks = tl.load(FULL_Q_NUM_BLKS + sparse_full_q_num_blks_offset)

                offs_m1 = q_start + tl.arange(0, BLOCK_M1)
                dk, dv = bwd_dkdv_inner(
                    {{gen_argdefs()}},
                    Q1, DO1, DELTA1, LSE1,
                    desc_q, desc_do, q_start,
                    dk, dv, k, v,
                    {%- if PANEL_DOTS %}
                    k_lo, k_hi, v_lo, v_hi,
                    {%- endif %}
                    off_zq, off_hq1, offs_n1, offs_m1,
                    stride_qm, stride_qd, stride_dom, stride_dod,
                    q_indices, sparse_q_num_blocks,
                    MATMUL_PRECISION,
                    IS_FULL_BLOCKS=True,
                )

{% endif %}        # Write back dV and dK.
        dv_ptrs = DV + offs_n1[:, None].to(INDEX_DTYPE) * stride_dvm + offs_v[None, :].to(INDEX_DTYPE) * stride_dvd

        index_n = offs_n1[:, None]
        index_k = offs_k[None, :]
        index_v = offs_v[None, :]

        if IS_DIVISIBLE and SAFE_HEAD_DIM:
            tl.store(dv_ptrs, dv)
        else:
            tl.store(dv_ptrs, dv, mask=(index_n < KV_LEN) & (index_v < V_HEAD_DIM))

        {%- if ROCM_GQA_SPLITS == 1 %}
        dk *= SM_SCALE
        {%- endif %}

        if SAFE_HEAD_DIM:
            mask = index_n < KV_LEN
        else:
            mask = (index_n < KV_LEN) & (index_k < QK_HEAD_DIM)

        # first compute broadcasted dk of shape [Bq, Hkv, KV_LEN, V_HEAD_DIM]
        # then reduce to dk of shape [Bkv, Hkv, KV_LEN, V_HEAD_DIM]
        tl.static_assert(dk.shape == [BLOCK_N1, QK_HEAD_DIM_ROUNDED])
        {{store_output(("off_zq", "off_howner", "index_n", "index_k"), "dk", "mask", indent_width=8, val_shape=("BLOCK_N1", "QK_HEAD_DIM_ROUNDED"))}}
    {%- endif %}

@triton.jit
def bwd_dq_inner(
    {{gen_argdefs()}},
    K, V, desc_k, desc_v, kv_start, start_m2,
    dq, q, do, Di, lse,
    off_z, off_hq,
    stride_kn, stride_kd, stride_vn, stride_vd,
    kv_indices, sparse_kv_num_blocks,
    MATMUL_PRECISION,
    IS_FULL_BLOCKS,
):

    {{gen_defines() | indent_except_first(1) }}
    SPARSE_KV_MULTIPLE: tl.constexpr = (SPARSE_KV_BLOCK_SIZE // BLOCK_N2)
    RCP_LN2: tl.constexpr = 1.44269504
    Q_LEN = {{size("Q", 2)}}
    KV_LEN = {{size("K", 2)}}

    offs_k = tl.arange(0, QK_HEAD_DIM_ROUNDED)
    offs_v = tl.arange(0, V_HEAD_DIM_ROUNDED)

    # BLOCK_M2 must be a multiple of BLOCK_N2, otherwise the code wouldn't work.
    tl.static_assert(BLOCK_M2 % BLOCK_N2 == 0)

    hi = tl.minimum(sparse_kv_num_blocks * SPARSE_KV_MULTIPLE, tl.maximum(tl.cdiv(KV_LEN, BLOCK_N2), 1))

    kv_offset = 0
    {%- if ROCM_D96_DQ_UNROLL2 and D96_DQ_EARLY_DP %}
    for start_n in tl.range(0, hi, loop_unroll_factor=2):
    {%- else %}
    for start_n in range(0, hi):
    {%- endif %}
        dq = bwd_dq_block_mn(
            {{gen_argdefs()}},
            dq, q, K, V, desc_k, desc_v, kv_start, kv_offset, start_m2,
            do, Di, lse, Q_LEN, KV_LEN,
            off_z, off_hq, offs_k, offs_v,
            stride_kn, stride_kd, stride_vn, stride_vd,
            kv_indices, sparse_kv_num_blocks,
            MATMUL_PRECISION, RCP_LN2,
            IS_FULL_BLOCKS,
        )

        # Increment pointers.
        offset = get_offset_for_next_block(
            start_n, kv_indices, sparse_kv_num_blocks,
            SPARSE_KV_BLOCK_SIZE, SPARSE_KV_MULTIPLE, BLOCK_N2, BLOCKS_ARE_CONTIGUOUS
        )

        kv_offset += offset

    return dq


@triton.jit
def bwd_dq_block_mn(
    {{gen_argdefs()}},
    dq, q, K, V, desc_k, desc_v, kv_start, kv_offset, start_m2,
    do, Di, lse, Q_LEN, KV_LEN,
    off_z, off_hq, offs_k, offs_v,
    stride_kn, stride_kd, stride_vn, stride_vd,
    kv_indices, sparse_kv_num_blocks,
    MATMUL_PRECISION, RCP_LN2,
    IS_FULL_BLOCKS,
):
    {{gen_defines() | indent_except_first(1)}}

    offs_n2 = kv_start + kv_offset + tl.arange(0, BLOCK_N2)
    offs_m2 = start_m2  + tl.arange(0, BLOCK_M2)
    {%- if USE_TMA %}
    k = tl.load_tensor_descriptor(
        desc_k,
        [(kv_start + kv_offset).to(tl.int32), 0],
    )
    kT = tl.trans(k)
    {%- else %}
    kT_ptrs = K + offs_n2[None, :].to(INDEX_DTYPE) * stride_kn + offs_k[:, None].to(INDEX_DTYPE) * stride_kd
    vT_ptrs = V + offs_n2[None, :].to(INDEX_DTYPE) * stride_vn + offs_v[:, None].to(INDEX_DTYPE) * stride_vd
    # NB reversed order to since K is transposed
    kT = load_checked_2d(kT_ptrs, offs_k, offs_n2, None, None, SAFE_HEAD_DIM, IS_DIVISIBLE, QK_HEAD_DIM, KV_LEN, INDEX_DTYPE)
    {%- endif %}
    qk = tl.dot(q, kT, input_precision=FLOAT32_PRECISION)
    {%- if D192_DQ_EARLY_DP or D96_DQ_EARLY_DP %}
    vT = load_checked_2d(vT_ptrs, offs_v, offs_n2, None, None, SAFE_HEAD_DIM, IS_DIVISIBLE, V_HEAD_DIM, KV_LEN, INDEX_DTYPE)
    dp = tl.dot(do, vT, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    if not PRESCALE_QK:
        qk *= SM_SCALE
    # ~~~~~~~~~~~~~~~~~~~ Apply score modification  ~~~~~~~~~~~~~~~~~~~
    pre_mod_scores = qk
    n = get_bounded_indices(offs_n2[None, :], KV_LEN if not IS_DIVISIBLE else None)
    # The boundary check is done for the outer loop, but here it's possible since we're iterating across N dim
    # that the M reads out of bounds for the PIDS spanning the Q_LEN boundary
    m = get_bounded_indices(offs_m2[:, None], Q_LEN if not IS_DIVISIBLE else None)

    {{ modification(
        subgraph_number=0,
        output_name="post_mod_scores",
        score="qk",
        b="off_z",
        h="off_hq",
        m="m",
        n="n",
        out="qk",
        input_shapes={
            "score": ("BLOCK_M2", "BLOCK_N2"),
            "m": ("BLOCK_M2", "1"),
            "n": ("1", "BLOCK_N2"),
        },
        input_dtypes={
            "b": "index",
            "h": "index",
            "m": "index",
            "n": "index",
        }
    ) | indent_except_first(1) }}


    {# Note: Selective masking DQ
    We load elements beyond KV_LEN w/ zero, some score mods may convert these elements to NaN
    Example: lambda x, *_: 1 / score, this NaN would propagate regardless of other masking
    We only need to do this on the m1 dim since these elements take part in the final reduction
    for DQ #}
    if not IS_DIVISIBLE:
        post_mod_scores = tl.where(offs_n2[None, :] < KV_LEN, post_mod_scores, float("-inf"))

    if not IS_FULL_BLOCKS:
        {{ modification(
            subgraph_number=2,
            output_name="mask_mod_output",
            score="qk",
            b="off_z",
            h="off_hq",
            m="m",
            n="n",
            input_shapes={
                "score": ("BLOCK_M2", "BLOCK_N2"),
                "m": ("BLOCK_M2", "1"),
                "n": ("1", "BLOCK_N2"),
            },
            input_dtypes={
                "b": "index",
                "h": "index",
                "m": "index",
                "n": "index",
            }
        ) | indent_except_first(2) }}

        # apply mask for partial masked block
        post_mod_scores = tl.where(mask_mod_output, post_mod_scores, float("-inf"))
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    if not PRESCALE_QK:
        post_mod_scores *= RCP_LN2
    p = tl.math.exp2(post_mod_scores - lse)
    # Compute dP and dS.
    # NB reversed order to since V is transposed
    {%- if not (D192_DQ_EARLY_DP or D96_DQ_EARLY_DP) %}
    {%- if USE_TMA %}
    v = tl.load_tensor_descriptor(
        desc_v,
        [(kv_start + kv_offset).to(tl.int32), 0],
    )
    vT = tl.trans(v)
    {%- else %}
    vT = load_checked_2d(vT_ptrs, offs_v, offs_n2, None, None, SAFE_HEAD_DIM, IS_DIVISIBLE, V_HEAD_DIM, KV_LEN, INDEX_DTYPE)
    {%- endif %}
    dp = tl.dot(do, vT, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    ds = p * (dp - Di[:, None])
    # ~~~~~~~~~~~~~~~~~~~ Apply joint modification  ~~~~~~~~~~~~~~~~~~~
    {{ modification(
        subgraph_number=1,
        output_name = "grad_scores",
        score="pre_mod_scores",
        b="off_z",
        h="off_hq",
        m="m",
        n="n",
        grad_score_mod="ds",
        input_shapes={
            "score": ("BLOCK_M2", "BLOCK_N2"),
            "grad_score_mod": ("BLOCK_M2", "BLOCK_N2"),
            "m": ("BLOCK_M2", "1"),
            "n": ("1", "BLOCK_N2"),
        },
        input_dtypes={
            "b": "index",
            "h": "index",
            "m": "index",
            "n": "index",
        }
    ) | indent_except_first(1) }}
    {# See Note Selective masking DQ #}
    if not IS_DIVISIBLE:
        grad_scores = tl.where(offs_n2[None, :] < KV_LEN, grad_scores, 0.0)

    # ~~~~~~~~~~~~~~~~~~~ Apply other buffer grad writes ~~~~~~~~~~~~~
    if WRITE_DQ:
        scatter_mask = (offs_m2[:, None] < Q_LEN ) & (offs_n2[None, :] < KV_LEN)
        {{ modification(
            subgraph_number=3,
            output_name=None,
            mask="scatter_mask",
            input_shapes={
                "score": ("BLOCK_M2", "BLOCK_N2"),
                "grad_score_mod": ("BLOCK_M2", "BLOCK_N2"),
                "m": ("BLOCK_M2", "1"),
                "n": ("1", "BLOCK_N2"),
                "b": ("1", "1"),
                "h": ("1", "1"),
            },
            input_dtypes={
                "b": "index",
                "h": "index",
                "m": "index",
                "n": "index",
            },
            score="pre_mod_scores",
            b="off_z",
            h="off_hq",
            m="m",
            n="n",
            grad_score_mod="ds"
        ) | indent_except_first(2) }}
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ds = grad_scores

    if not IS_FULL_BLOCKS:
        # (grads) apply mask for partially unmasked block
        ds = tl.where(mask_mod_output, ds, 0.0)
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ds = ds.to(MATMUL_PRECISION)
    # Compute dQ.
    dq += tl.dot(ds, tl.trans(kT), input_precision=FLOAT32_PRECISION)

    return dq
{% if GQA_QUERY_TILE_OUTER %}

@triton.jit
def bwd_dkdv_all_heads_inner(
    {{gen_argdefs()}},
    Q, DO, DELTA, LSE, q_start,
    dk, dv, k, v,
    off_zq, off_hkv, off_hsplit, offs_n1, offs_m1,
    stride_qz, stride_qh, stride_doz, stride_doh,
    stride_qm, stride_qd, stride_dom, stride_dod,
    q_indices, sparse_q_num_blocks,
    MATMUL_PRECISION,
    IS_FULL_BLOCKS,
):
    {{gen_defines() | indent_except_first(1) }}
    SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M1)
    RCP_LN2: tl.constexpr = 1.44269504
    Q_LEN = {{size("Q", 2)}}
    KV_LEN = {{size("K", 2)}}
    HQ = {{size("Q", 1)}}
    offs_k = tl.arange(0, QK_HEAD_DIM_ROUNDED)
    offs_v = tl.arange(0, V_HEAD_DIM_ROUNDED)
    tl.static_assert(BLOCK_N1 % BLOCK_M1 == 0)
{% if BLOCKS_ARE_CONTIGUOUS %}
    hi = tl.minimum(sparse_q_num_blocks * SPARSE_Q_MULTIPLE, tl.maximum(tl.cdiv(Q_LEN, BLOCK_M1), 1))
    offset_block = 0
    for start_m in range(0, hi):
        for off_g in range(0, GQA_SHARED_HEADS // ROCM_GQA_SPLITS):
            off_hq1 = off_hkv * GQA_SHARED_HEADS + off_hsplit * (GQA_SHARED_HEADS // ROCM_GQA_SPLITS) + off_g
            q_adj1 = (stride_qh * off_hq1 + stride_qz * off_zq).to(tl.int64)
            do_adj1 = (stride_doh * off_hq1 + stride_doz * off_zq).to(tl.int64)
            off_chz1 = ((off_zq * HQ + off_hq1) * Q_LEN).to(tl.int64)
            Q1 = Q + q_adj1
            DO1 = DO + do_adj1
            LSE1 = LSE + off_chz1
            DELTA1 = DELTA + off_chz1
            dk, dv = bwd_dkdv_block_mn(
                {{gen_argdefs()}},
                dk, dv, Q1, k, v, DO1, DELTA1, LSE1,
                None, None, q_start, offset_block, Q_LEN, KV_LEN,
                off_zq, off_hq1, offs_n1, offs_m1, offs_k, offs_v,
                stride_qm, stride_qd, stride_dom, stride_dod,
                q_indices, sparse_q_num_blocks,
                MATMUL_PRECISION, RCP_LN2,
                IS_FULL_BLOCKS,
            )
        offset = get_offset_for_next_block(
            start_m, q_indices, sparse_q_num_blocks,
            SPARSE_Q_BLOCK_SIZE, SPARSE_Q_MULTIPLE, BLOCK_M1, BLOCKS_ARE_CONTIGUOUS
        )
        offs_m1 += offset
        offset_block += offset
{% else %}
    for sparse_q_idx in range(0, sparse_q_num_blocks):
        q_block = tl.load(q_indices + sparse_q_idx, eviction_policy="evict_last")
        q_start = q_block * SPARSE_Q_BLOCK_SIZE
        for q_subtile in tl.range(0, SPARSE_Q_MULTIPLE, loop_unroll_factor=1):
            offset_block = q_subtile * BLOCK_M1
            offs_m1 = q_start + offset_block + tl.arange(0, BLOCK_M1)
            for off_g in range(0, GQA_SHARED_HEADS // ROCM_GQA_SPLITS):
                off_hq1 = off_hkv * GQA_SHARED_HEADS + off_hsplit * (GQA_SHARED_HEADS // ROCM_GQA_SPLITS) + off_g
                q_adj1 = (stride_qh * off_hq1 + stride_qz * off_zq).to(tl.int64)
                do_adj1 = (stride_doh * off_hq1 + stride_doz * off_zq).to(tl.int64)
                off_chz1 = ((off_zq * HQ + off_hq1) * Q_LEN).to(tl.int64)
                Q1 = Q + q_adj1
                DO1 = DO + do_adj1
                LSE1 = LSE + off_chz1
                DELTA1 = DELTA + off_chz1
                dk, dv = bwd_dkdv_block_mn(
                    {{gen_argdefs()}},
                    dk, dv, Q1, k, v, DO1, DELTA1, LSE1,
                    None, None, q_start, offset_block, Q_LEN, KV_LEN,
                    off_zq, off_hq1, offs_n1, offs_m1, offs_k, offs_v,
                    stride_qm, stride_qd, stride_dom, stride_dod,
                    q_indices, sparse_q_num_blocks,
                    MATMUL_PRECISION, RCP_LN2,
                    IS_FULL_BLOCKS,
                )
{% endif %}
    return dk, dv
{% endif %}

@triton.jit
def bwd_dkdv_inner(
    {{gen_argdefs()}},
    Q, DO, DELTA, LSE, # pointers
    desc_q, desc_do, q_start,
    dk, dv, k, v,
    {%- if PANEL_DOTS %}
    k_lo, k_hi, v_lo, v_hi,
    {%- endif %}
    off_z, off_hq, offs_n1, offs_m1,
    stride_qm, stride_qd, stride_dom, stride_dod,
    q_indices, sparse_q_num_blocks,
    MATMUL_PRECISION,
    IS_FULL_BLOCKS,
):
    {{gen_defines() | indent_except_first(1) }}
    SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M1)
    RCP_LN2: tl.constexpr = 1.44269504
    Q_LEN = {{size("Q", 2)}}
    KV_LEN = {{size("K", 2)}}

    offs_k = tl.arange(0, QK_HEAD_DIM_ROUNDED)
    offs_v = tl.arange(0, V_HEAD_DIM_ROUNDED)

    # BLOCK_N1 must be a multiple of BLOCK_M1, otherwise the code wouldn't work.
    tl.static_assert(BLOCK_N1 % BLOCK_M1 == 0)

    # The minimum is needed to handle the case where we run with a super large
    # SPARSE_BLOCK_SIZE (i.e. no block-mask!)
    hi = tl.minimum(sparse_q_num_blocks * SPARSE_Q_MULTIPLE, tl.maximum(tl.cdiv(Q_LEN, BLOCK_M1), 1))

    offset_block = 0
    for start_m in range(0, hi):
        dk, dv = bwd_dkdv_block_mn(
            {{gen_argdefs()}},
            dk, dv, Q, k, v, DO, DELTA, LSE,
            {%- if PANEL_DOTS %}
            k_lo, k_hi, v_lo, v_hi,
            {%- endif %}
            desc_q, desc_do, q_start, offset_block, Q_LEN, KV_LEN,
            off_z, off_hq, offs_n1, offs_m1, offs_k, offs_v,
            stride_qm, stride_qd, stride_dom, stride_dod,
            q_indices, sparse_q_num_blocks,
            MATMUL_PRECISION, RCP_LN2,
            IS_FULL_BLOCKS,
        )
        # Increment pointers.
        offset = get_offset_for_next_block(
            start_m, q_indices, sparse_q_num_blocks,
            SPARSE_Q_BLOCK_SIZE, SPARSE_Q_MULTIPLE, BLOCK_M1, BLOCKS_ARE_CONTIGUOUS
        )
        offs_m1 += offset
        offset_block += offset

    return dk, dv


@triton.jit
def bwd_dkdv_block_mn(
    {{gen_argdefs()}},
    dk, dv, Q, k, v, DO, DELTA, LSE,
    {%- if PANEL_DOTS %}
    k_lo, k_hi, v_lo, v_hi,
    {%- endif %}
    desc_q, desc_do, q_start, offset, Q_LEN, KV_LEN,
    off_z, off_hq, offs_n1, offs_m1, offs_k, offs_v,
    stride_qm, stride_qd, stride_dom, stride_dod,
    q_indices, sparse_q_num_blocks,
    MATMUL_PRECISION, RCP_LN2,
    IS_FULL_BLOCKS,
):
    {{gen_defines() | indent_except_first(1) }}

    {%- if USE_TMA %}
    q = tl.load_tensor_descriptor(
        desc_q,
        [(q_start + offset).to(tl.int32), 0],
    )
    qT = tl.trans(q)
    {%- else %}
    {%- if PANEL_DOTS %}
    panel_features = tl.arange(0, {{ PANEL_WIDTH }})
    qT_lo_ptrs = Q + offs_m1[None, :].to(INDEX_DTYPE) * stride_qm + panel_features[:, None].to(INDEX_DTYPE) * stride_qd
    qT_hi_ptrs = qT_lo_ptrs + {{ PANEL_WIDTH }} * stride_qd
    {%- if D96_PANEL_DOTS %}
    qT_lo = tl.load(qT_lo_ptrs, mask=(offs_m1[None, :] < Q_LEN) & (panel_features[:, None] < QK_HEAD_DIM), other=0.0)
    qT_hi = tl.load(qT_hi_ptrs, mask=(offs_m1[None, :] < Q_LEN) & ((panel_features[:, None] + 64) < QK_HEAD_DIM), other=0.0)
    {%- elif ROCM_D192_PANEL_DOTS %}
    qT_lo = tl.load(qT_lo_ptrs, mask=(offs_m1[None, :] < Q_LEN) & (panel_features[:, None] < QK_HEAD_DIM), other=0.0)
    qT_hi = tl.load(qT_hi_ptrs, mask=(offs_m1[None, :] < Q_LEN) & ((panel_features[:, None] + 128) < QK_HEAD_DIM), other=0.0)
    {%- else %}
    qT_lo = tl.load(qT_lo_ptrs, mask=offs_m1[None, :] < Q_LEN, other=0.0)
    qT_hi = tl.load(qT_hi_ptrs, mask=offs_m1[None, :] < Q_LEN, other=0.0)
    {%- endif %}
    qT = tl.cat(qT_lo, qT_hi, dim=0)
    {%- else %}
    qT_ptrs = Q + offs_m1[None, :].to(INDEX_DTYPE) * stride_qm + offs_k[:, None].to(INDEX_DTYPE) * stride_qd
    do_ptrs = DO + offs_m1[:, None].to(INDEX_DTYPE) * stride_dom + offs_v[None, :].to(INDEX_DTYPE) * stride_dod
    # NB reversed order since Q is transposed
    qT = load_checked_2d(qT_ptrs, offs_k, offs_m1, None, None, SAFE_HEAD_DIM, IS_DIVISIBLE, QK_HEAD_DIM, Q_LEN, INDEX_DTYPE)
    {%- endif %}
    {%- endif %}
    # Load LSE before computing qk to reduce pipeline stall.
    if IS_DIVISIBLE:
        lse = tl.load(LSE + offs_m1)
    else:
        lse = tl.load(LSE + offs_m1, mask=offs_m1 < Q_LEN)
    lse = tl.where(lse == -float("inf"), 0.0, lse)
    if ROCM_EARLY_DP:
        {%- if USE_TMA %}
        do = tl.load_tensor_descriptor(
            desc_do,
            [(q_start + offset).to(tl.int32), 0],
        )
        {%- else %}
        {%- if PANEL_DOTS %}
        do_lo_ptrs = DO + offs_m1[:, None].to(INDEX_DTYPE) * stride_dom + panel_features[None, :].to(INDEX_DTYPE) * stride_dod
        do_hi_ptrs = do_lo_ptrs + {{ PANEL_WIDTH }} * stride_dod
        {%- if D96_PANEL_DOTS %}
        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 64) < V_HEAD_DIM), other=0.0)
        {%- elif ROCM_D192_PANEL_DOTS %}
        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 128) < V_HEAD_DIM), other=0.0)
        {%- else %}
        do_lo = tl.load(do_lo_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        {%- endif %}
        do = tl.cat(do_lo, do_hi, dim=1)
        {%- else %}
        do = load_checked_2d(do_ptrs, offs_m1, offs_v, None, None, IS_DIVISIBLE, SAFE_HEAD_DIM, Q_LEN, V_HEAD_DIM, INDEX_DTYPE)
        {%- endif %}
        {%- endif %}
    {%- if PANEL_DOTS %}
    qkT = tl.dot(k_lo, qT_lo, input_precision=FLOAT32_PRECISION)
    qkT = tl.dot(k_hi, qT_hi, acc=qkT, input_precision=FLOAT32_PRECISION)
    {%- else %}
    qkT = tl.dot(k, qT, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    if ROCM_EARLY_DP:
        {%- if PANEL_DOTS %}
        dpT = tl.dot(v_lo, tl.trans(do_lo), input_precision=FLOAT32_PRECISION)
        dpT = tl.dot(v_hi, tl.trans(do_hi), acc=dpT, input_precision=FLOAT32_PRECISION)
        {%- else %}
        dpT = tl.dot(v, tl.trans(do), input_precision=FLOAT32_PRECISION)
        {%- endif %}
    if not PRESCALE_QK:
        qkT *= SM_SCALE
    # ~~~~~~~~~~~~~~~~~~~ Apply score modification  ~~~~~~~~~~~~~~~~~~~
    m = get_bounded_indices(offs_m1[None, :], Q_LEN if not IS_DIVISIBLE else None)
    # The boundary check is done for the outer loop, but here it's possible since we're iterating across M dim
    # that the n reads out of bounds for the PIDS spanning the KV_LEN boundary
    n = get_bounded_indices(offs_n1[:, None], KV_LEN if not IS_DIVISIBLE else None)

    pre_mod_scores = qkT
    {{ modification(
        subgraph_number=0,
        output_name="post_mod_scores",
        score="qkT",
        b="off_z",
        h="off_hq",
        m="m",
        n="n",
        out="qkT",
        input_shapes={
            "score": ("BLOCK_N1", "BLOCK_M1"),
            "m": ("1", "BLOCK_M1"),
            "n": ("BLOCK_N1", "1"),
        },
        input_dtypes={
            "b": "index",
            "h": "index",
            "m": "index",
            "n": "index",
        }
    ) | indent_except_first(1) }}

    {# Note: Selective masking DK/DV
    We load elements beyond Q_LEN w/ zero, some score mods may convert these elements to NaN
    Example: lambda x, *_: 1 / score, this NaN would propagate regardless of other masking
    We only need to do this on the m1 dim since these elements take part in the final reduction
    for DK/DV #}
    if not IS_DIVISIBLE:
        post_mod_scores = tl.where(offs_m1[None, :] < Q_LEN, post_mod_scores, float("-inf"))

    if not IS_FULL_BLOCKS:
        {{ modification(
            subgraph_number=2,
            output_name="mask_mod_output",
            b="off_z",
            h="off_hq",
            m="m",
            n="n",
            input_shapes={
                "m": ("1", "BLOCK_M1"),
                "n": ("BLOCK_N1", "1"),
            },
            input_dtypes={
                "b": "index",
                "h": "index",
                "m": "index",
                "n": "index",
            }
        ) | indent_except_first(2) }}
        # (grads) apply mask for fully masked block
        post_mod_scores = tl.where(mask_mod_output, post_mod_scores, float("-inf"))
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    if not PRESCALE_QK:
        post_mod_scores *= RCP_LN2
    pT = tl.math.exp2(post_mod_scores - lse[None, :])
    if not ROCM_EARLY_DP:
        {%- if USE_TMA %}
        do = tl.load_tensor_descriptor(
            desc_do,
            [(q_start + offset).to(tl.int32), 0],
        )
        {%- else %}
        {%- if PANEL_DOTS %}
        do_lo_ptrs = DO + offs_m1[:, None].to(INDEX_DTYPE) * stride_dom + panel_features[None, :].to(INDEX_DTYPE) * stride_dod
        do_hi_ptrs = do_lo_ptrs + {{ PANEL_WIDTH }} * stride_dod
        {%- if D96_PANEL_DOTS %}
        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 64) < V_HEAD_DIM), other=0.0)
        {%- elif ROCM_D192_PANEL_DOTS %}
        do_lo = tl.load(do_lo_ptrs, mask=(offs_m1[:, None] < Q_LEN) & (panel_features[None, :] < V_HEAD_DIM), other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=(offs_m1[:, None] < Q_LEN) & ((panel_features[None, :] + 128) < V_HEAD_DIM), other=0.0)
        {%- else %}
        do_lo = tl.load(do_lo_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        do_hi = tl.load(do_hi_ptrs, mask=offs_m1[:, None] < Q_LEN, other=0.0)
        {%- endif %}
        do = tl.cat(do_lo, do_hi, dim=1)
        {%- else %}
        do = load_checked_2d(do_ptrs, offs_m1, offs_v, None, None, IS_DIVISIBLE, SAFE_HEAD_DIM, Q_LEN, V_HEAD_DIM, INDEX_DTYPE)
        {%- endif %}
        {%- endif %}
    {%- if EARLY_PROBABILITY_COMPACT %}
    if IS_DIVISIBLE:
        Di = tl.load(DELTA + offs_m1)
    else:
        Di = tl.load(DELTA + offs_m1, mask=offs_m1 < Q_LEN)
    # Compute dP and dS.
    if not ROCM_EARLY_DP:
        {%- if PANEL_DOTS %}
        dpT = tl.dot(v_lo, tl.trans(do_lo), input_precision=FLOAT32_PRECISION)
        dpT = tl.dot(v_hi, tl.trans(do_hi), acc=dpT, input_precision=FLOAT32_PRECISION)
        {%- else %}
        dpT = tl.dot(v, tl.trans(do), input_precision=FLOAT32_PRECISION)
        {%- endif %}
    dsT = pT * (dpT - Di[None, :])
    ppT = pT.to(MATMUL_PRECISION)
    # ~~~~~~~~~~~~~~~~~~~ Apply joint modification  ~~~~~~~~~~~~~~~~~~~
    {{ modification(
        subgraph_number=1,
        output_name = "grad_scores",
        score="pre_mod_scores",
        b="off_z",
        h="off_hq",
        m="m",
        n="n",
        grad_score_mod="dsT",
        input_shapes={
            "score": ("BLOCK_N1", "BLOCK_M1"),
            "grad_score_mod": ("BLOCK_N1", "BLOCK_M1"),
            "m": ("1", "BLOCK_M1"),
            "n": ("BLOCK_N1", "1"),
        },
        input_dtypes={
            "b": "index",
            "h": "index",
            "m": "index",
            "n": "index",
        }
    ) | indent_except_first(1) }}

    {# See Note: Selective masking DK/DV#}
    if not IS_DIVISIBLE:
        grad_scores = tl.where(offs_m1[None, :] < Q_LEN, grad_scores, 0.0)

    # ~~~~~~~~~~~~~~~~~~~ Apply other buffer grad writes ~~~~~~~~~~~~~
    if not WRITE_DQ:
        idx_b = off_z
        idx_h = off_hq
        idx_m = m
        idx_n = n
        scatter_mask = (offs_m1[None, :] < Q_LEN) & (offs_n1[:, None] < KV_LEN)
        {{ modification(
            subgraph_number=3,
            output_name=None,
            mask="scatter_mask",
            input_shapes={
                "score": ("BLOCK_N1", "BLOCK_M1"),
                "grad_score_mod": ("BLOCK_N1", "BLOCK_M1"),
                "m": ("1", "BLOCK_M1"),
                "n": ("BLOCK_N1", "1"),
                "b": ("1", "1"),
                "h": ("1", "1"),
            },
            input_dtypes={
                "b": "index",
                "h": "index",
                "m": "index",
                "n": "index",
            },
            score="pre_mod_scores",
            b="idx_b",
            h="idx_h",
            m="idx_m",
            n="idx_n",
            grad_score_mod="dsT"
        ) | indent_except_first(2) }}
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    dsT = grad_scores
    if not IS_FULL_BLOCKS:
        # (grads) apply mask for partially unmasked block
        dsT = tl.where(mask_mod_output, dsT, 0.0)
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    dsT = dsT.to(MATMUL_PRECISION)
    dv += tl.dot(ppT.to(MATMUL_PRECISION), do, input_precision=FLOAT32_PRECISION)
    dk += tl.dot(dsT.to(MATMUL_PRECISION), tl.trans(qT), input_precision=FLOAT32_PRECISION)
    {%- else %}
    # Compute dV.
    ppT = pT
    {%- if D128_DV_VIEW_CARRY_SPLIT64 %}
    dv_do_view = tl.reshape(do, (BLOCK_M1, 2, 64), can_reorder=False)
    dv_do_pairs = tl.trans(dv_do_view, 0, 2, 1)
    dv_do_lo, dv_do_hi = tl.split(dv_do_pairs)
    dv_carry_view = tl.reshape(dv, (BLOCK_N1, 2, 64), can_reorder=False)
    dv_carry_pairs = tl.trans(dv_carry_view, 0, 2, 1)
    dv_carry_lo, dv_carry_hi = tl.split(dv_carry_pairs)
    dv_probability = ppT.to(MATMUL_PRECISION)
    {%- if GQA_QUERY_TILE_OUTER_FP16 %}
    DV_FRAGMENT: tl.constexpr = V_HEAD_DIM_ROUNDED // 4
    dv_do_lo_pairs = tl.trans(tl.reshape(dv_do_lo, (BLOCK_M1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_do_hi_pairs = tl.trans(tl.reshape(dv_do_hi, (BLOCK_M1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_do_0, dv_do_1 = tl.split(dv_do_lo_pairs)
    dv_do_2, dv_do_3 = tl.split(dv_do_hi_pairs)
    dv_carry_lo_pairs = tl.trans(tl.reshape(dv_carry_lo, (BLOCK_N1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_carry_hi_pairs = tl.trans(tl.reshape(dv_carry_hi, (BLOCK_N1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_carry_0, dv_carry_1 = tl.split(dv_carry_lo_pairs)
    dv_carry_2, dv_carry_3 = tl.split(dv_carry_hi_pairs)
    dv_update_0 = tl.dot(dv_probability, dv_do_0, acc=dv_carry_0, input_precision=FLOAT32_PRECISION)
    dv_update_1 = tl.dot(dv_probability, dv_do_1, acc=dv_carry_1, input_precision=FLOAT32_PRECISION)
    dv_update_lo = tl.cat(dv_update_0, dv_update_1, dim=1)
    {%- else %}
    dv_update_lo = tl.dot(dv_probability, dv_do_lo, acc=dv_carry_lo, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    {%- if not GQA_QUERY_TILE_OUTER_FP16 %}
    dv_update_hi = tl.dot(dv_probability, dv_do_hi, acc=dv_carry_hi, input_precision=FLOAT32_PRECISION)
    dv = tl.cat(dv_update_lo, dv_update_hi, dim=1)
    {%- endif %}
    {%- else %}
    dv += tl.dot(ppT.to(MATMUL_PRECISION), do, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    if IS_DIVISIBLE:
        Di = tl.load(DELTA + offs_m1)
    else:
        Di = tl.load(DELTA + offs_m1, mask=offs_m1 < Q_LEN)
    # Compute dP and dS.
    if not ROCM_EARLY_DP:
        {%- if PANEL_DOTS %}
        dpT = tl.dot(v_lo, tl.trans(do_lo), input_precision=FLOAT32_PRECISION)
        dpT = tl.dot(v_hi, tl.trans(do_hi), acc=dpT, input_precision=FLOAT32_PRECISION)
        {%- else %}
        dpT = tl.dot(v, tl.trans(do), input_precision=FLOAT32_PRECISION)
        {%- endif %}
    dsT = pT * (dpT - Di[None, :])
    # ~~~~~~~~~~~~~~~~~~~ Apply joint modification  ~~~~~~~~~~~~~~~~~~~
    {{ modification(
        subgraph_number=1,
        output_name = "grad_scores",
        score="pre_mod_scores",
        b="off_z",
        h="off_hq",
        m="m",
        n="n",
        grad_score_mod="dsT",
        input_shapes={
            "score": ("BLOCK_N1", "BLOCK_M1"),
            "grad_score_mod": ("BLOCK_N1", "BLOCK_M1"),
            "m": ("1", "BLOCK_M1"),
            "n": ("BLOCK_N1", "1"),
        },
        input_dtypes={
            "b": "index",
            "h": "index",
            "m": "index",
            "n": "index",
        }
    ) | indent_except_first(1) }}

    {# See Note: Selective masking DK/DV#}
    if not IS_DIVISIBLE:
        grad_scores = tl.where(offs_m1[None, :] < Q_LEN, grad_scores, 0.0)

    # ~~~~~~~~~~~~~~~~~~~ Apply other buffer grad writes ~~~~~~~~~~~~~
    if not WRITE_DQ:
        idx_b = off_z
        idx_h = off_hq
        idx_m = m
        idx_n = n
        scatter_mask = (offs_m1[None, :] < Q_LEN) & (offs_n1[:, None] < KV_LEN)
        {{ modification(
            subgraph_number=3,
            output_name=None,
            mask="scatter_mask",
            input_shapes={
                "score": ("BLOCK_N1", "BLOCK_M1"),
                "grad_score_mod": ("BLOCK_N1", "BLOCK_M1"),
                "m": ("1", "BLOCK_M1"),
                "n": ("BLOCK_N1", "1"),
                "b": ("1", "1"),
                "h": ("1", "1"),
            },
            input_dtypes={
                "b": "index",
                "h": "index",
                "m": "index",
                "n": "index",
            },
            score="pre_mod_scores",
            b="idx_b",
            h="idx_h",
            m="idx_m",
            n="idx_n",
            grad_score_mod="dsT"
        ) | indent_except_first(2) }}
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    dsT = grad_scores
    if not IS_FULL_BLOCKS:
        # (grads) apply mask for partially unmasked block
        dsT = tl.where(mask_mod_output, dsT, 0.0)
    # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    dk += tl.dot(dsT.to(MATMUL_PRECISION), tl.trans(qT), input_precision=FLOAT32_PRECISION)
    {%- if GQA_QUERY_TILE_OUTER_FP16 %}
    dv_update_2 = tl.dot(dv_probability, dv_do_2, acc=dv_carry_2, input_precision=FLOAT32_PRECISION)
    dv_update_3 = tl.dot(dv_probability, dv_do_3, acc=dv_carry_3, input_precision=FLOAT32_PRECISION)
    dv_update_hi = tl.cat(dv_update_2, dv_update_3, dim=1)
    dv = tl.cat(dv_update_lo, dv_update_hi, dim=1)
    {%- endif %}
    {%- endif %}

    return dk, dv
