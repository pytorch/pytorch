{% macro backward_dv_update(default) %}
{% if D128_DV_VIEW_CARRY_SPLIT64 %}
    # Compute dV.
    ppT = pT
    dv_do_view = tl.reshape(do, (BLOCK_M1, 2, 64), can_reorder=False)
    dv_do_pairs = tl.trans(dv_do_view, 0, 2, 1)
    dv_do_lo, dv_do_hi = tl.split(dv_do_pairs)
    dv_carry_view = tl.reshape(dv, (BLOCK_N1, 2, 64), can_reorder=False)
    dv_carry_pairs = tl.trans(dv_carry_view, 0, 2, 1)
    dv_carry_lo, dv_carry_hi = tl.split(dv_carry_pairs)
    dv_probability = ppT.to(MATMUL_PRECISION)
    {%- if GQA_QUERY_TILE_OUTER_FP16 %}
    DV_FRAGMENT: tl.constexpr = V_HEAD_DIM_ROUNDED // 4
    dv_do_lo_pairs = tl.trans(tl.reshape(dv_do_lo, (BLOCK_M1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_do_hi_pairs = tl.trans(tl.reshape(dv_do_hi, (BLOCK_M1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_do_0, dv_do_1 = tl.split(dv_do_lo_pairs)
    dv_do_2, dv_do_3 = tl.split(dv_do_hi_pairs)
    dv_carry_lo_pairs = tl.trans(tl.reshape(dv_carry_lo, (BLOCK_N1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_carry_hi_pairs = tl.trans(tl.reshape(dv_carry_hi, (BLOCK_N1, 2, DV_FRAGMENT), can_reorder=False), 0, 2, 1)
    dv_carry_0, dv_carry_1 = tl.split(dv_carry_lo_pairs)
    dv_carry_2, dv_carry_3 = tl.split(dv_carry_hi_pairs)
    dv_update_0 = tl.dot(dv_probability, dv_do_0, acc=dv_carry_0, input_precision=FLOAT32_PRECISION)
    dv_update_1 = tl.dot(dv_probability, dv_do_1, acc=dv_carry_1, input_precision=FLOAT32_PRECISION)
    dv_update_lo = tl.cat(dv_update_0, dv_update_1, dim=1)
    {%- else %}
    dv_update_lo = tl.dot(dv_probability, dv_do_lo, acc=dv_carry_lo, input_precision=FLOAT32_PRECISION)
    {%- endif %}
    {%- if not GQA_QUERY_TILE_OUTER_FP16 %}
    dv_update_hi = tl.dot(dv_probability, dv_do_hi, acc=dv_carry_hi, input_precision=FLOAT32_PRECISION)
    dv = tl.cat(dv_update_lo, dv_update_hi, dim=1)
    {%- endif %}
{% else %}
