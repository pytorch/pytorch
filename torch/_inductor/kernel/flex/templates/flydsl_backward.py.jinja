        mask_buffer_0,
        mask_buffer_1,
        mask_buffer_2,
        mask_buffer_3,
        grad_query_workspace,
        stream,
    )
    run_flydsl_template(
        _launcher.get(query.device),
        dispatch_args,
        compiler=flyc.compile,
        tensor_converter=flyc.from_torch_tensor,
    )
    return grad_query


