def _run_flydsl_backward(
    query,
    key,
    value,
    attention_output,
    grad_output,
    logsumexp,
    grad_key,
    grad_value,
    kv_num_blocks,
    kv_indices,
    full_kv_num_blocks,
    full_kv_indices,
    delta,
    grad_query_workspace,
    partial_kv_counts,
    partial_kv_indices,
    full_kv_counts,
    full_kv_indices_transposed,
{% for name in buffer_args + table_args %}
    {{name}},
{% endfor %}
    grad_query,
    stream,
):
{% if CAPTURE_TABLE %}
    fill_flydsl_capture_table(
        _capture_table_launchers,
        CAPTURE_TABLE_SLOTS,
        capture_table,
        ({% for name in buffer_args %}{{name}}, {% endfor %}),
        stream,
        compiler=flyc.compile,
        tensor_converter={{ "flydsl_runtime_layout_arg" if RUNTIME_SIZES else "flyc.from_torch_tensor" }},
    )
    # The table takes the first capture slot, then each capture with runtime
    # extents; the others alias kv_num_blocks.
    buffers = (capture_table,{% for name in extent_args %} {{name}},{% endfor %}) + (kv_num_blocks,) * {{ 3 - extent_args | length }}
{% else %}
    # Unused capture slots alias kv_num_blocks.
    buffers = ({% for name in buffer_args %}{{name}}, {% endfor %}) + (kv_num_blocks,) * {{ 4 - buffer_args | length }}
{% endif %}
    dispatch_args = (
        query,
        key,
        value,
        attention_output,
        logsumexp,
        grad_output,
        grad_query,
        grad_key,
        grad_value,
        kv_num_blocks,
        kv_indices,
        full_kv_num_blocks,
        full_kv_indices,
        delta,
        partial_kv_counts,
        partial_kv_indices,
        full_kv_counts,
        full_kv_indices_transposed,
        *buffers,
        grad_query_workspace,
        stream,
    )
    run_flydsl_template(
        _launcher.get(query.device),
        dispatch_args,
        compiler=flyc.compile,
        tensor_converter={{ "flydsl_runtime_layout_arg" if RUNTIME_SIZES else "flyc.from_torch_tensor" }},
    )
    return grad_query


{% set kernel_args = [
