    )


def {{kernel_name}}_precompile(
    precompile_shapes,
    precompile_strides,
    precompile_dtypes,
    device_index=0,
    device_capability=None,
    flydsl_gpu_arch=None,
):
    """Warm FlyDSL's disk cache using metadata-only fake tensors."""
    del device_index, device_capability
    precompile_flydsl_template(
        {{kernel_name}}_main,
        (
{% for name in kernel_args %}
            "{{name}}",
{% endfor %}
        ),
        precompile_shapes,
        precompile_strides,
        precompile_dtypes,
        flydsl_gpu_arch,
    )
