{% else %}
{{def_kernel("Q", "K", "V", "OUT", "D_OUT", "LSE", "DK", "DV")}}
{% endif %}
    # DQ is the primary template output; DK / DV are mutated in place.
    DQ = {{get_output()}}
    b, h, s, d = Q.shape
    block_m = SPARSE_Q_BLOCK_SIZE
    block_n = SPARSE_KV_BLOCK_SIZE
    launch = _get_bwd_launch(int(b), int(h), int(s), int(d), int(block_m), int(block_n))

    # The vendored prologue derives both backward halves from the forward
    # (q-major) block mask kv_num_blocks / kv_indices.
    # NOTE(flydsl-bwd): the lowering threads the Q-major mask
    # (q_num_blocks / q_indices). Confirm on device that this is the mask the
    # prologue expects; a causal / sliding-window mask is not equal to its
    # transpose, so the wrong direction silently produces wrong grads.
{% if HAS_BLOCK_MASK %}
    kv_num_blocks = Q_NUM_BLKS
    kv_indices = Q_IDX
    full_kv_num_blocks = FULL_Q_NUM_BLKS
    full_kv_indices = FULL_Q_IDX
{% else %}
    # Dense: every block fully unmasked (no partial blocks).
    n_blocks = int(s) // int(block_m)
    dev = Q.device
    kv_num_blocks = torch.zeros(n_blocks, dtype=torch.int32, device=dev)
    kv_indices = torch.zeros(n_blocks * n_blocks, dtype=torch.int32, device=dev)
    full_kv_num_blocks = torch.full(
        (n_blocks,), n_blocks, dtype=torch.int32, device=dev
    )
    full_kv_indices = (
        torch.arange(n_blocks, dtype=torch.int32, device=dev)
        .repeat(n_blocks)
    )
{% endif %}

    # NOTE(flydsl-bwd): launch_fn takes an fx.Stream (or None -> default). The
    # Inductor `stream` here is a raw handle; passing None runs on the default
    # stream, which is fine for correctness testing. Wire the real stream before
    # landing (perf / stream-ordering).
    launch(
        Q, K, V, OUT, LSE, D_OUT, DQ, DK, DV,
        kv_num_blocks, kv_indices, full_kv_num_blocks, full_kv_indices,
        stream=None,
    )
    return DQ
