import threading

import torch

from torch._inductor.kernel.vendored_templates.flydsl.kernels.flex_attn_bwd_gfx950 import (
    build_flex_attn_bwd_module,
)

{{gen_defines()}}


# One built module (compiled kernels + scratch) per problem shape.
_bwd_modules = {}
_bwd_modules_lock = threading.Lock()


def _get_bwd_launch(b, h, s, d, block_m, block_n):
    key = (b, h, s, d, block_m, block_n)
    launch = _bwd_modules.get(key)
    if launch is None:
        with _bwd_modules_lock:
            launch = _bwd_modules.get(key)
            if launch is None:
                launch = build_flex_attn_bwd_module(
                    b, h, s, d, "bf16", block_m, block_n
                )
                _bwd_modules[key] = launch
    return launch


