            FULL_KV_NUM_BLKS = _fake_proxy("FULL_KV_NUM_BLKS")
            FULL_KV_IDX = _fake_proxy("FULL_KV_IDX")
            DELTA = _fake_proxy("DELTA")
            CP_Q = _fake_proxy("CP_Q")
