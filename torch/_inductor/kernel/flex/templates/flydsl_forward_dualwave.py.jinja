    full_kv_indices,
{%- for name in buffer_args %}
    {{name}},
{%- endfor %}
{%- endif %}
    output,
    stream,
):
    run_flydsl_template(
        _launcher.get(query.device),
{%- if MODS %}
        (
            query,
            key,
            value,
            logsumexp,
            max_scores,
            kv_num_blocks,
            kv_indices,
            full_kv_num_blocks,
            full_kv_indices,
{%- for name in buffer_args %}
            {{name}},
{%- endfor %}
            output,
            stream,
        ),
{%- else %}
        (query, key, value, logsumexp, max_scores, output, stream),
{%- endif %}
        compiler=flyc.compile,
        tensor_converter={{ "flydsl_runtime_layout_arg" if RUNTIME_SIZES else "flyc.from_torch_tensor" }},
    )
    return output


