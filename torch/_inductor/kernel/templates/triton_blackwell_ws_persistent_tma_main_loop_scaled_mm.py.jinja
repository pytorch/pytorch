{{def_kernel("A", "B", "A_inverse_scale", "B_inverse_scale")}}
    M = {{size("A", 0)}}
    N = {{size("B", 1)}}
    K = {{size("A", 1)}}
    if M * N == 0:
        # early exit due to zero-size input(s)
        return
    tl.static_assert(BLOCK_K % 128 == 0, "K128 block scaling requires BLOCK_K % 128 == 0")
    tl.static_assert(BLOCK_M == 128, "Block-scaled MMAv5 requires BLOCK_M == 128")
    tl.static_assert(BLOCK_N % 128 == 0, "BLOCK_N must be divisible by 128")
    SCALE_K_TILES: tl.constexpr = BLOCK_K // 128
    start_pid = tl.program_id(0)
    grid_m = tl.cdiv(M, BLOCK_M)
    grid_n = tl.cdiv(N, BLOCK_N)
    k_tiles = tl.cdiv(K, BLOCK_K)
    num_tiles = grid_m * grid_n
    # Packed MN x K4 UE8M0 scales, as eager cuBLASLt takes them: rows padded to
    # a multiple of 4, one 4-byte word per (row, group of four K128 blocks),
    # rows fastest within a group. Reading them in the kernel keeps the inputs
    # the same as the other scaled_mm choices, so autotuning times all the work.
    scale_group_stride_a = (M + 3) // 4 * 16
    scale_group_stride_b = (N + 3) // 4 * 16
    k_blocks = tl.cdiv(K, 128)

    {{tma_descriptor("a_desc", "A",
        [BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M],
        [0, 1] if A_ROW_MAJOR else [1, 0]
    )}}
    {{tma_descriptor("b_desc", "B",
        [BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
        [0, 1] if B_ROW_MAJOR else [1, 0]
    )}}
    # tile_id_c is used in the epilogue to break the dependency between
    # the prologue and the epilogue
    tile_id_c = start_pid - NUM_SMS
    num_pid_in_group = GROUP_M * grid_n

    {%- if USE_META_WS %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
        data_partition_factor=DATA_PARTITION_FACTOR,
        separate_epilogue_store=SEPARATE_EPILOGUE_STORE,
    ):
    {%- else %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
    ):
    {%- endif %}
        pid_m, pid_n = _compute_pid(
            tile_id, num_pid_in_group, grid_m, GROUP_M
        )
        offs_am = pid_m * BLOCK_M
        offs_bn = pid_n * BLOCK_N
        offs_am_desc = offs_am.to(tl.int32)
        offs_bn_desc = offs_bn.to(tl.int32)
        scale_rows_a = offs_am + tl.arange(0, BLOCK_M)
        scale_rows_b = offs_bn + tl.arange(0, BLOCK_N)

        accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
        for ki in tl.range(
            0, k_tiles, disallow_acc_multi_buffer=True
        ):
            offs_k = ki * BLOCK_K
            offs_k_desc = offs_k.to(tl.int32)
            a = a_desc.load(
                [offs_am_desc, offs_k_desc]
                if A_ROW_MAJOR
                else [offs_k_desc, offs_am_desc],
            )
            b = b_desc.load(
                [offs_k_desc, offs_bn_desc]
                if B_ROW_MAJOR
                else [offs_bn_desc, offs_k_desc],
            )
            # One UE8M0 per (row, K128 block). Block-scaled MMA takes one per
            # K32, so each is repeated over its four K32 chunks. Rows past M/N
            # and K blocks past K read as 127 (1.0): the packing's padding could
            # be NaN, and it would scale TMA's zero fill.
            scale_kb = ki * SCALE_K_TILES + tl.arange(0, SCALE_K_TILES)
            scale_kb_ok = scale_kb < k_blocks
            scale_a = tl.load(
                A_inverse_scale
                + (scale_kb // 4)[None, :] * scale_group_stride_a
                + scale_rows_a[:, None] * 4
                + (scale_kb % 4)[None, :],
                mask=(scale_rows_a[:, None] < M) & scale_kb_ok[None, :],
                other=127,
            )
            scale_b = tl.load(
                B_inverse_scale
                + (scale_kb // 4)[None, :] * scale_group_stride_b
                + scale_rows_b[:, None] * 4
                + (scale_kb % 4)[None, :],
                mask=(scale_rows_b[:, None] < N) & scale_kb_ok[None, :],
                other=127,
            )
            scale_a = tl.reshape(
                tl.broadcast_to(scale_a[:, :, None], (BLOCK_M, SCALE_K_TILES, 4)),
                (BLOCK_M, BLOCK_K // 32),
            )
            scale_b = tl.reshape(
                tl.broadcast_to(scale_b[:, :, None], (BLOCK_N, SCALE_K_TILES, 4)),
                (BLOCK_N, BLOCK_K // 32),
            )
            accumulator = tl.dot_scaled(
                a if A_ROW_MAJOR else a.T,
                scale_a,
                "e4m3",
                b if B_ROW_MAJOR else b.T,
                scale_b,
                "e4m3",
                acc=accumulator,
                fast_math=False,
            )

        tile_id_c += NUM_SMS
        pid_m, pid_n = _compute_pid(
            tile_id_c, num_pid_in_group, grid_m, GROUP_M
        )
        offs_cm = pid_m * BLOCK_M
        offs_cn = pid_n * BLOCK_N
        subtiles = _subtile_accumulator(accumulator, BLOCK_M, BLOCK_N, EPILOGUE_SUBTILE)
        for i in tl.static_range(EPILOGUE_SUBTILE):
            subtile = subtiles[i]
            offs_cn_i = offs_cn + i * (BLOCK_N // EPILOGUE_SUBTILE)
            {{store_output(
                ("offs_cm", "offs_cn_i"),
                "subtile",
                indent_width=12,
                val_shape=("BLOCK_M", "BLOCK_N // EPILOGUE_SUBTILE"),
                block_indexing=True
            )}}
