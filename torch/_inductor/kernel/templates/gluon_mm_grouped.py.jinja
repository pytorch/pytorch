@gluon.jit
def _proton_enter_scope(name: gl.constexpr):
    if {{ ENABLE_PROTON_PROFILING }}:
        pl.enter_scope(name)


@gluon.jit
def _proton_exit_scope(name: gl.constexpr):
    if {{ ENABLE_PROTON_PROFILING }}:
        pl.exit_scope(name)


@aggregate
class PartitionArgs:
    a_desc: tma.tensor_descriptor
    b_desc: tma.tensor_descriptor
{%- if K_IS_VARYING %}
    a_ptr: gl.tensor
    b_ptr: gl.tensor
    a_stride_outer: gl.tensor
    b_stride_outer: gl.tensor
    a_smem_layout: gl.constexpr
    b_smem_layout: gl.constexpr
{%- endif %}
{%- if USE_TMA_STORE and not C_IS_2D %}
{%- for t in TMA_STORES %}
    {{ t.var }}_desc: tma.tensor_descriptor
{%- endfor %}
{%- endif %}
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
    offs_ptr: gl.tensor
{%- endif %}
{%- if not HAS_EPILOGUE_FUSION %}
    c_ptr: gl.tensor
    c_stride_m: gl.tensor
    c_stride_n: gl.tensor
{%- if not C_IS_2D %}
    c_stride_g: gl.tensor
{%- endif %}
{%- endif %}
{%- if FUSED_TMA_STORE %}
{%- for t in TMA_STORES %}
{%- if C_IS_2D %}
    {{ t.var }}_ptr: gl.tensor
    {{ t.var }}_stride_m: gl.tensor
{%- endif %}
    {{ t.var }}_smem_layout: gl.constexpr
{%- endfor %}
{%- endif %}
    output_dtype: gl.constexpr
    c_smem_layout: gl.constexpr
    a_smem_bufs: gl.shared_memory_descriptor
    b_smem_bufs: gl.shared_memory_descriptor
    acc_tmem_bufs: tensor_memory_descriptor
    load_buf_empty_bars: gl.shared_memory_descriptor
    load_buf_full_bars: gl.shared_memory_descriptor
    acc_buf_empty_bars: gl.shared_memory_descriptor
    acc_buf_full_bars: gl.shared_memory_descriptor
    G: gl.tensor
    M: gl.tensor
    N: gl.tensor
    K: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    BLOCK_K: gl.constexpr
    NUM_PROGRAMS: gl.constexpr
    GROUP_SIZE_N: gl.constexpr
    USE_TWO_CTA: gl.constexpr
    EPILOGUE_N: gl.constexpr
    EPILOGUE_STAGES: gl.constexpr


@aggregate
class GroupIterator:
    G: gl.tensor
    g: gl.tensor
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
    offs_ptr: gl.tensor
{%- endif %}
    m_start_offset: gl.tensor
    m_size: gl.tensor
    n_start_offset: gl.tensor
    n_size: gl.tensor
    k_start_offset: gl.tensor
    k_size: gl.tensor
    tiles_processed: gl.tensor
    tile_idx: gl.tensor
    has_started: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    NUM_PROGRAMS: gl.constexpr

    @gluon.jit
    def should_process(self):
        return self.g < self.G

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        g = (self.g + 1) if self.has_started else 0
{%- if M_IS_VARYING %}
        m_start_offset = self.m_start_offset + (self.m_size if self.has_started else 0)
        m_size = gl.load(self.offs_ptr + g) - m_start_offset
{%- else %}
        m_start_offset = self.m_start_offset
        m_size = self.m_size
{%- endif %}
{%- if N_IS_VARYING %}
        n_start_offset = self.n_start_offset + (self.n_size if self.has_started else 0)
        n_size = gl.load(self.offs_ptr + g) - n_start_offset
{%- else %}
        n_start_offset = self.n_start_offset
        n_size = self.n_size
{%- endif %}
{%- if K_IS_VARYING %}
        k_start_offset = self.k_start_offset + (self.k_size if self.has_started else 0)
        k_size = gl.load(self.offs_ptr + g) - k_start_offset
{%- else %}
        k_start_offset = self.k_start_offset
        k_size = self.k_size
{%- endif %}

        tiles_processed = self.tiles_processed + (gl.cdiv(self.m_size, self.BLOCK_M) * gl.cdiv(self.n_size, self.BLOCK_N) if self.has_started else 0)
        tile_idx = self.tile_idx + (gl.cdiv(tiles_processed - self.tile_idx, self.NUM_PROGRAMS) * self.NUM_PROGRAMS if self.has_started else 0)

        return gl.aggregate_replace(
            self, g=g,
            m_start_offset=m_start_offset, m_size=m_size,
            n_start_offset=n_start_offset, n_size=n_size,
            k_start_offset=k_start_offset, k_size=k_size,
            tiles_processed=tiles_processed, tile_idx=tile_idx,
            has_started=gl.to_tensor(True),
        )


@gluon.jit
def create_group_iterator(
    G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
    offs_ptr,
{%- endif %}
    BLOCK_M: gl.constexpr, BLOCK_N: gl.constexpr, NUM_PROGRAMS: gl.constexpr
):
    zero = gl.to_tensor(0)
    return GroupIterator(
        G, zero,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        offs_ptr,
{%- endif %}
        zero, M, zero, N, zero, K,
        zero, gl.program_id(0),
        gl.to_tensor(False),
        BLOCK_M, BLOCK_N, NUM_PROGRAMS
    ).next()


@aggregate
class TileIterator:
    tile_idx: gl.tensor
    num_m_tiles: gl.tensor
    num_n_tiles: gl.tensor
    num_tiles: gl.tensor
    m_start_offset: gl.tensor
    m_size: gl.tensor
    n_start_offset: gl.tensor
    n_size: gl.tensor
    m_offset: gl.tensor
    n_offset: gl.tensor
    m_tile_offset: gl.tensor
    n_tile_offset: gl.tensor
    has_started: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    NUM_PROGRAMS: gl.constexpr
    GROUP_SIZE_N: gl.constexpr

    @gluon.jit
    def should_process(self):
        return self.tile_idx < self.num_tiles

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        tile_idx = self.tile_idx + (self.NUM_PROGRAMS if self.has_started else 0)
        # Walk GROUP_SIZE_N tile columns at a time so concurrent CTAs
        # touch a 2D block rather than one column, improving L2 reuse.
        # GROUP_SIZE_N == 1 is plain m-fastest order.
        tiles_per_group = self.num_m_tiles * self.GROUP_SIZE_N
        group_idx = tile_idx // tiles_per_group
        idx_in_group = tile_idx % tiles_per_group
        first_n = group_idx * self.GROUP_SIZE_N
        group_n = gl.minimum(self.num_n_tiles - first_n, self.GROUP_SIZE_N)
        tile_m_idx = idx_in_group // group_n
        tile_n_idx = first_n + idx_in_group % group_n
        m_tile_offset = tile_m_idx * self.BLOCK_M
        n_tile_offset = tile_n_idx * self.BLOCK_N
        m_offset = self.m_start_offset + m_tile_offset
        n_offset = self.n_start_offset + n_tile_offset

        return gl.aggregate_replace(
            self, tile_idx=tile_idx,
            m_offset=m_offset, n_offset=n_offset,
            m_tile_offset=m_tile_offset, n_tile_offset=n_tile_offset,
            has_started=gl.to_tensor(True),
        )


@gluon.jit
def create_tile_iterator(
    tile_idx,
    m_start_offset, m_size, n_start_offset, n_size,
    BLOCK_M: gl.constexpr, BLOCK_N: gl.constexpr, NUM_PROGRAMS: gl.constexpr,
    GROUP_SIZE_N: gl.constexpr
):
    num_m_tiles = gl.cdiv(m_size, BLOCK_M)
    num_n_tiles = gl.cdiv(n_size, BLOCK_N)
    num_tiles = num_m_tiles * num_n_tiles
    zero = gl.to_tensor(0)
    return TileIterator(
        tile_idx, num_m_tiles, num_n_tiles, num_tiles,
        m_start_offset, m_size, n_start_offset, n_size,
        zero, zero, zero, zero,
        gl.to_tensor(False),
        BLOCK_M, BLOCK_N, NUM_PROGRAMS, GROUP_SIZE_N
    ).next()


# Counter abstraction for tracking barrier index and phase.
@aggregate
class Counter:
    index: gl.tensor
    phase: gl.tensor
    num_barriers: gl.constexpr

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        incr = self.index + 1
        rollover = incr == self.num_barriers
        return gl.aggregate_replace(
            self,
            index=gl.where(rollover, 0, incr),
            phase=gl.where(rollover, self.phase ^ 1, self.phase),
        )


@gluon.jit
def create_counter(phase, num_barriers: gl.constexpr):
    return Counter(gl.to_tensor(0), gl.to_tensor(phase), num_barriers)


@gluon.jit
def load_partition(pargs: PartitionArgs):
    _proton_enter_scope("load_partition")

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    BLOCK_K: gl.constexpr = pargs.BLOCK_K
    NUM_PROGRAMS: gl.constexpr = pargs.NUM_PROGRAMS
    GROUP_SIZE_N: gl.constexpr = pargs.GROUP_SIZE_N
    USE_TWO_CTA: gl.constexpr = pargs.USE_TWO_CTA
    TILE_M: gl.constexpr = BLOCK_M * 2 if USE_TWO_CTA else BLOCK_M

    load_buf_empty_bars = pargs.load_buf_empty_bars
    load_buf_full_bars = pargs.load_buf_full_bars
    state = create_counter(1, load_buf_empty_bars.shape[0])
{%- if K_IS_VARYING %}
    num_loads = gl.to_tensor(0)
{%- endif %}

    group_iter = create_group_iterator(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        TILE_M, BLOCK_N, NUM_PROGRAMS
    )
    while group_iter.should_process():
{%- if K_IS_VARYING %}
        # In-flight loads read the descriptors, so wait for the last one first.
        last_load = gl.maximum(num_loads - 1, 0)
        mbarrier.wait(
            load_buf_empty_bars.index(last_load % state.num_barriers),
            (last_load // state.num_barriers) & 1,
            pred=num_loads > 0,
        )
        # Clamp K to this group's end: the ragged tail then lands out
        # of bounds and the TMA zero-fills it.
        k_end = group_iter.k_start_offset + group_iter.k_size
        a_desc = tma.make_tensor_descriptor(
            pargs.a_ptr,
{%- if A_IS_K_MAJOR %}
            shape=[M, k_end],
            strides=[pargs.a_stride_outer, 1],
            block_shape=[TILE_M, BLOCK_K],
{%- else %}
            shape=[k_end, M],
            strides=[pargs.a_stride_outer, 1],
            block_shape=[BLOCK_K, TILE_M],
{%- endif %}
            layout=pargs.a_smem_layout,
        )
        b_desc = tma.make_tensor_descriptor(
            pargs.b_ptr,
{%- if B_IS_K_MAJOR %}
            shape=[N, k_end],
            strides=[pargs.b_stride_outer, 1],
            block_shape=[BLOCK_N, BLOCK_K],
{%- else %}
            shape=[k_end, N],
            strides=[pargs.b_stride_outer, 1],
            block_shape=[BLOCK_K, BLOCK_N],
{%- endif %}
            layout=pargs.b_smem_layout,
        )
{%- else %}
        a_desc = pargs.a_desc
        b_desc = pargs.b_desc
{%- endif %}
        tile_iter = create_tile_iterator(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            TILE_M, BLOCK_N, NUM_PROGRAMS, GROUP_SIZE_N
        )
        while tile_iter.should_process():
            for k in range(0, group_iter.k_size, BLOCK_K):
                k_offset = group_iter.k_start_offset + k

                load_buf_empty_bar = load_buf_empty_bars.index(state.index)
                load_buf_full_bar = load_buf_full_bars.index(state.index)
                a_smem = pargs.a_smem_bufs.index(state.index)
                b_smem = pargs.b_smem_bufs.index(state.index)

                _proton_enter_scope("load_wait")
                mbarrier.wait(load_buf_empty_bar, state.phase)
                _proton_exit_scope("load_wait")

                _proton_enter_scope("load_work")
                mbarrier.expect(
                    load_buf_full_bar,
                    a_desc.nbytes_per_cta + b_desc.nbytes_per_cta,
                )

                tma.async_load(
                    a_desc,
{%- if A_IS_2D %}
{%- if A_IS_K_MAJOR %}
                    [tile_iter.m_offset, k_offset],
{%- else %}
                    [k_offset, tile_iter.m_offset],
{%- endif %}
{%- else %}
{%- if A_IS_K_MAJOR %}
                    [group_iter.g, tile_iter.m_offset, k_offset],
{%- else %}
                    [group_iter.g, k_offset, tile_iter.m_offset],

{%- endif %}
{%- endif %}
                    load_buf_full_bar,
                    a_smem,
                    multicast=USE_TWO_CTA
                )
                tma.async_load(
                    b_desc,
{%- if B_IS_2D %}
{%- if B_IS_K_MAJOR %}
                    [tile_iter.n_offset, k_offset],
{%- else %}
                    [k_offset, tile_iter.n_offset],
{%- endif %}
{%- else %}
{%- if B_IS_K_MAJOR %}
                    [group_iter.g, tile_iter.n_offset, k_offset],
{%- else %}
                    [group_iter.g, k_offset, tile_iter.n_offset],
{%- endif %}
{%- endif %}
                    load_buf_full_bar,
                    b_smem,
                    multicast=USE_TWO_CTA
                )
                _proton_exit_scope("load_work")

                state = state.next()
{%- if K_IS_VARYING %}
                num_loads += 1
{%- endif %}

            tile_iter = tile_iter.next()

        group_iter = group_iter.next()

    _proton_exit_scope("load_partition")


@gluon.jit
def compute_partition(pargs: PartitionArgs):
    _proton_enter_scope("compute_partition")

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    BLOCK_K: gl.constexpr = pargs.BLOCK_K
    NUM_PROGRAMS: gl.constexpr = pargs.NUM_PROGRAMS
    GROUP_SIZE_N: gl.constexpr = pargs.GROUP_SIZE_N
    USE_TWO_CTA: gl.constexpr = pargs.USE_TWO_CTA
    TILE_M: gl.constexpr = BLOCK_M * 2 if USE_TWO_CTA else BLOCK_M

    load_buf_empty_bars = pargs.load_buf_empty_bars
    load_buf_full_bars = pargs.load_buf_full_bars
    load_state = create_counter(0, load_buf_empty_bars.shape[0])

    acc_buf_empty_bars = pargs.acc_buf_empty_bars
    acc_buf_full_bars = pargs.acc_buf_full_bars
    acc_state = create_counter(1, acc_buf_empty_bars.shape[0])

    group_iter = create_group_iterator(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        TILE_M, BLOCK_N, NUM_PROGRAMS
    )
    while group_iter.should_process():
        tile_iter = create_tile_iterator(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            TILE_M, BLOCK_N, NUM_PROGRAMS, GROUP_SIZE_N
        )
        while tile_iter.should_process():
            acc_buf_empty_bar = acc_buf_empty_bars.index(acc_state.index)

            _proton_enter_scope("compute_wait_acc")
            mbarrier.wait(acc_buf_empty_bar, acc_state.phase)
            _proton_exit_scope("compute_wait_acc")

            acc = pargs.acc_tmem_bufs.index(acc_state.index)
            use_acc = False

            for k in range(0, group_iter.k_size, BLOCK_K):
                load_buf_empty_bar = load_buf_empty_bars.index(load_state.index)
                load_buf_full_bar = load_buf_full_bars.index(load_state.index)

                _proton_enter_scope("compute_wait")
                mbarrier.wait(load_buf_full_bar, load_state.phase)
                _proton_exit_scope("compute_wait")

                _proton_enter_scope("compute_work")
                a_smem = pargs.a_smem_bufs.index(load_state.index)
                b_smem = pargs.b_smem_bufs.index(load_state.index)
{%- if not A_IS_K_MAJOR %}
                a_smem = a_smem.permute((1, 0))
{%- endif %}
{%- if B_IS_K_MAJOR %}
                b_smem = b_smem.permute((1, 0))
{%- endif %}

                tcgen05_mma(a_smem, b_smem, acc, use_acc=use_acc)
                tcgen05_commit(
                    load_buf_empty_bar,
                    descs=[pargs.a_smem_bufs.index(0), pargs.b_smem_bufs.index(0)] if USE_TWO_CTA else [],
                )
                _proton_exit_scope("compute_work")

                use_acc = True
                load_state = load_state.next()

            _proton_enter_scope("compute_commit_acc")
            acc_buf_full_bar = acc_buf_full_bars.index(acc_state.index)

            tcgen05_commit(
                acc_buf_full_bar,
                descs=[pargs.a_smem_bufs.index(0), pargs.b_smem_bufs.index(0)] if USE_TWO_CTA else [],
            )

            acc_state = acc_state.next()
            _proton_exit_scope("compute_commit_acc")

            tile_iter = tile_iter.next()

        group_iter = group_iter.next()

    _proton_exit_scope("compute_partition")


@gluon.jit
def store_partition(pargs: PartitionArgs{% if HAS_EPILOGUE_FUSION %}, {{gen_argdefs()}}{% endif %}):
    _proton_enter_scope("store_partition")
{%- if HAS_EPILOGUE_FUSION %}

    INDEX_DTYPE: gl.constexpr = {{ INDEX_DTYPE_EXPR }}
{%- endif %}

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    NUM_PROGRAMS: gl.constexpr = pargs.NUM_PROGRAMS
    GROUP_SIZE_N: gl.constexpr = pargs.GROUP_SIZE_N
    USE_TWO_CTA: gl.constexpr = pargs.USE_TWO_CTA
    TILE_M: gl.constexpr = BLOCK_M * 2 if USE_TWO_CTA else BLOCK_M

    acc_buf_empty_bars = pargs.acc_buf_empty_bars
    acc_buf_full_bars = pargs.acc_buf_full_bars
    acc_state = create_counter(0, acc_buf_empty_bars.shape[0])

{%- if USE_TMA_STORE %}
    EPILOGUE_N: gl.constexpr = pargs.EPILOGUE_N
    EPILOGUE_STAGES: gl.constexpr = pargs.EPILOGUE_STAGES
    {#- TODO: move the TMA store into a shared helper once other Gluon templates need it. #}
    c_smem = gl.allocate_shared_memory(
        pargs.output_dtype, [EPILOGUE_STAGES, TILE_M, EPILOGUE_N], pargs.c_smem_layout
    )
{%- if FUSED_TMA_STORE %}
{%- for t in TMA_STORES %}
    {{ t.var }}_smem = c_smem.reinterpret({{ t.dtype }}, [EPILOGUE_STAGES, TILE_M, EPILOGUE_N], pargs.{{ t.var }}_smem_layout)
{%- endfor %}
{%- endif %}
    epilogue_state = create_counter(0, EPILOGUE_STAGES)
{%- else %}
    EPILOGUE_N: gl.constexpr = BLOCK_N
{%- endif %}

    group_iter = create_group_iterator(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        TILE_M, BLOCK_N, NUM_PROGRAMS
    )
    while group_iter.should_process():
{%- if USE_TMA_STORE %}
{%- if C_IS_2D %}
        # Clamp C to this group's extent so a tail tile's out-of-range
        # rows are dropped by the store. Draining first is what makes
        # rewriting the descriptor safe (make_tensor_descriptor's fence
        # lowering unconditionally drains this warp's outstanding TMA
        # reads, TMAToLLVM.cpp's TensormapFenceproxyAcquireOpConversion,
        # "wait_group.read 0", currently a ptxas-bug workaround with a
        # removal TODO).
        tma.store_wait(pendings=0)
{%- for t in TMA_STORES %}
        {{ t.var }}_desc = tma.make_tensor_descriptor(
            pargs.{{ t.var }}_ptr,
{%- if M_IS_VARYING %}
            shape=[group_iter.m_start_offset + group_iter.m_size, N],
{%- else %}
            shape=[M, group_iter.n_start_offset + group_iter.n_size],
{%- endif %}
            strides=[pargs.{{ t.var }}_stride_m, 1],
            block_shape=[TILE_M, EPILOGUE_N],
            layout=pargs.{{ t.var }}_smem_layout,
        )
{%- endfor %}
{%- else %}
{%- for t in TMA_STORES %}
        {{ t.var }}_desc = pargs.{{ t.var }}_desc
{%- endfor %}
{%- endif %}
{%- endif %}
        tile_iter = create_tile_iterator(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            TILE_M, BLOCK_N, NUM_PROGRAMS, GROUP_SIZE_N
        )
        while tile_iter.should_process():
            acc_buf_full_bar = acc_buf_full_bars.index(acc_state.index)

            _proton_enter_scope("store_wait")
            mbarrier.wait(acc_buf_full_bar, acc_state.phase)
            _proton_exit_scope("store_wait")

            _proton_enter_scope("store_work")
            acc_tmem = pargs.acc_tmem_bufs.index(acc_state.index)
