@gluon.jit
def _proton_enter_scope(name: gl.constexpr):
    if {{ ENABLE_PROTON_PROFILING }}:
        pl.enter_scope(name)


@gluon.jit
def _proton_exit_scope(name: gl.constexpr):
    if {{ ENABLE_PROTON_PROFILING }}:
        pl.exit_scope(name)


@aggregate
class PartitionArgs:
    a_desc: tma.tensor_descriptor
    b_desc: tma.tensor_descriptor
{%- if USE_TMA_STORE %}
    c_desc: tma.tensor_descriptor
{%- endif %}
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
    offs_ptr: gl.tensor
{%- endif %}
    c_ptr: gl.tensor
    c_stride_m: gl.tensor
    c_stride_n: gl.tensor
{%- if not USE_TMA_STORE %}
    output_dtype: gl.constexpr
{%- endif %}
    c_smem_layout: gl.constexpr
    a_smem_bufs: gl.shared_memory_descriptor
    b_smem_bufs: gl.shared_memory_descriptor
    acc_tmem_bufs: tensor_memory_descriptor
    load_buf_empty_bars: gl.shared_memory_descriptor
    load_buf_full_bars: gl.shared_memory_descriptor
    acc_buf_empty_bars: gl.shared_memory_descriptor
    acc_buf_full_bars: gl.shared_memory_descriptor
    G: gl.tensor
    M: gl.tensor
    N: gl.tensor
    K: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    BLOCK_K: gl.constexpr
    NUM_BLOCKS: gl.constexpr


@aggregate
class GroupIterator:
    G: gl.tensor
    g: gl.tensor
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
    offs_ptr: gl.tensor
{%- endif %}
    m_start_offset: gl.tensor
    m_size: gl.tensor
    n_start_offset: gl.tensor
    n_size: gl.tensor
    k_start_offset: gl.tensor
    k_size: gl.tensor
    tiles_processed: gl.tensor
    tile_idx: gl.tensor
    has_started: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    NUM_BLOCKS: gl.constexpr

    @gluon.jit
    def create(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        offs_ptr,
{%- endif %}
        BLOCK_M: gl.constexpr, BLOCK_N: gl.constexpr, NUM_BLOCKS: gl.constexpr
    ):
        zero = gl.to_tensor(0)
        return GroupIterator(
            G, zero,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
            offs_ptr,
{%- endif %}
            zero, M, zero, N, zero, K,
            zero, gl.program_id(0),
            gl.to_tensor(False),
            BLOCK_M, BLOCK_N, NUM_BLOCKS
        ).next()

    @gluon.jit
    def should_process(self):
        return self.g < self.G

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        g = (self.g + 1) if self.has_started else 0
{%- if M_IS_VARYING %}
        m_start_offset = self.m_start_offset + (self.m_size if self.has_started else 0)
        m_size = gl.load(self.offs_ptr + g) - m_start_offset
{%- else %}
        m_start_offset = self.m_start_offset
        m_size = self.m_size
{%- endif %}
{%- if N_IS_VARYING %}
        n_start_offset = self.n_start_offset + (self.n_size if self.has_started else 0)
        n_size = gl.load(self.offs_ptr + g) - n_start_offset
{%- else %}
        n_start_offset = self.n_start_offset
        n_size = self.n_size
{%- endif %}
{%- if K_IS_VARYING %}
        k_start_offset = self.k_start_offset + (self.k_size if self.has_started else 0)
        k_size = gl.load(self.offs_ptr + g) - k_start_offset
{%- else %}
        k_start_offset = self.k_start_offset
        k_size = self.k_size
{%- endif %}

        tiles_processed = self.tiles_processed + (gl.cdiv(self.m_size, self.BLOCK_M) * gl.cdiv(self.n_size, self.BLOCK_N) if self.has_started else 0)
        tile_idx = self.tile_idx + (gl.cdiv(tiles_processed - self.tile_idx, self.NUM_BLOCKS) * self.NUM_BLOCKS if self.has_started else 0)

        return GroupIterator(
            self.G, g,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
            self.offs_ptr,
{%- endif %}
            m_start_offset, m_size, n_start_offset, n_size, k_start_offset, k_size,
            tiles_processed, tile_idx,
            gl.to_tensor(True),
            self.BLOCK_M, self.BLOCK_N, self.NUM_BLOCKS
        )


@aggregate
class TileIterator:
    tile_idx: gl.tensor
    num_m_tiles: gl.tensor
    num_n_tiles: gl.tensor
    num_tiles: gl.tensor
    m_start_offset: gl.tensor
    m_size: gl.tensor
    n_start_offset: gl.tensor
    n_size: gl.tensor
    m_offset: gl.tensor
    n_offset: gl.tensor
    m_tile_offset: gl.tensor
    n_tile_offset: gl.tensor
    has_started: gl.tensor
    BLOCK_M: gl.constexpr
    BLOCK_N: gl.constexpr
    NUM_BLOCKS: gl.constexpr

    @gluon.jit
    def create(
        tile_idx,
        m_start_offset, m_size, n_start_offset, n_size,
        BLOCK_M: gl.constexpr, BLOCK_N: gl.constexpr, NUM_BLOCKS: gl.constexpr
    ):
        num_m_tiles = gl.cdiv(m_size, BLOCK_M)
        num_n_tiles = gl.cdiv(n_size, BLOCK_N)
        num_tiles = num_m_tiles * num_n_tiles
        zero = gl.to_tensor(0)
        return TileIterator(
            tile_idx, num_m_tiles, num_n_tiles, num_tiles,
            m_start_offset, m_size, n_start_offset, n_size,
            zero, zero, zero, zero,
            gl.to_tensor(False),
            BLOCK_M, BLOCK_N, NUM_BLOCKS
        ).next()

    @gluon.jit
    def should_process(self):
        return self.tile_idx < self.num_tiles

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        tile_idx = self.tile_idx + (self.NUM_BLOCKS if self.has_started else 0)
        tile_m_idx = tile_idx % self.num_m_tiles
        tile_n_idx = tile_idx // self.num_m_tiles
        m_tile_offset = tile_m_idx * self.BLOCK_M
        n_tile_offset = tile_n_idx * self.BLOCK_N
        m_offset = self.m_start_offset + m_tile_offset
        n_offset = self.n_start_offset + n_tile_offset

        return TileIterator(
            tile_idx, self.num_m_tiles, self.num_n_tiles, self.num_tiles,
            self.m_start_offset, self.m_size, self.n_start_offset, self.n_size,
            m_offset, n_offset, m_tile_offset, n_tile_offset,
            gl.to_tensor(True),
            self.BLOCK_M, self.BLOCK_N, self.NUM_BLOCKS
        )


# Counter abstraction for tracking barrier index and phase.
@aggregate
class Counter:
    index: gl.tensor
    phase: gl.tensor
    num_barriers: gl.constexpr

    @gluon.jit
    def create(phase, num_barriers: gl.constexpr):
        return Counter(gl.to_tensor(0), gl.to_tensor(phase), num_barriers)

    @gluon.must_use_result
    @gluon.jit
    def next(self):
        incr = self.index + 1
        rollover = incr == self.num_barriers
        return Counter(
            gl.where(rollover, 0, incr),
            gl.where(rollover, self.phase ^ 1, self.phase),
            self.num_barriers,
        )


@gluon.jit
def load_partition(pargs: PartitionArgs):
    _proton_enter_scope("load_partition")

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    BLOCK_K: gl.constexpr = pargs.BLOCK_K
    NUM_BLOCKS: gl.constexpr = pargs.NUM_BLOCKS

    load_buf_empty_bars = pargs.load_buf_empty_bars
    load_buf_full_bars = pargs.load_buf_full_bars
    state = Counter.create(1, load_buf_empty_bars.shape[0])

    group_iter = GroupIterator.create(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        BLOCK_M, BLOCK_N, NUM_BLOCKS
    )
    while group_iter.should_process():
        tile_iter = TileIterator.create(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            BLOCK_M, BLOCK_N, NUM_BLOCKS
        )
        while tile_iter.should_process():
            for k in range(0, group_iter.k_size, BLOCK_K):
                k_offset = group_iter.k_start_offset + k

                load_buf_empty_bar = load_buf_empty_bars.index(state.index)
                load_buf_full_bar = load_buf_full_bars.index(state.index)
                a_smem = pargs.a_smem_bufs.index(state.index)
                b_smem = pargs.b_smem_bufs.index(state.index)

                _proton_enter_scope("load_barrier_wait_empty")
                mbarrier.wait(load_buf_empty_bar, state.phase)
                _proton_exit_scope("load_barrier_wait_empty")

                _proton_enter_scope("load_barrier_expect")
                mbarrier.expect(
                    load_buf_full_bar,
                    pargs.a_desc.block_type.nbytes + pargs.b_desc.block_type.nbytes,
                )
                _proton_exit_scope("load_barrier_expect")

                _proton_enter_scope("load_tma_async")
                tma.async_copy_global_to_shared(
                    pargs.a_desc,
{%- if A_IS_2D %}
{%- if A_IS_K_MAJOR %}
                    [tile_iter.m_offset, k_offset],
{%- else %}
                    [k_offset, tile_iter.m_offset],
{%- endif %}
{%- else %}
{%- if A_IS_K_MAJOR %}
                    [group_iter.g, tile_iter.m_offset, k_offset],
{%- else %}
                    [group_iter.g, k_offset, tile_iter.m_offset],

{%- endif %}
{%- endif %}
                    load_buf_full_bar,
                    a_smem
                )
                tma.async_copy_global_to_shared(
                    pargs.b_desc,
{%- if B_IS_2D %}
{%- if B_IS_K_MAJOR %}
                    [tile_iter.n_offset, k_offset],
{%- else %}
                    [k_offset, tile_iter.n_offset],
{%- endif %}
{%- else %}
{%- if B_IS_K_MAJOR %}
                    [group_iter.g, tile_iter.n_offset, k_offset],
{%- else %}
                    [group_iter.g, k_offset, tile_iter.n_offset],
{%- endif %}
{%- endif %}
                    load_buf_full_bar,
                    b_smem
                )
                _proton_exit_scope("load_tma_async")

                state = state.next()

            tile_iter = tile_iter.next()

        group_iter = group_iter.next()

    _proton_exit_scope("load_partition")


@gluon.jit
def compute_partition(pargs: PartitionArgs):
    _proton_enter_scope("compute_partition")

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    BLOCK_K: gl.constexpr = pargs.BLOCK_K
    NUM_BLOCKS: gl.constexpr = pargs.NUM_BLOCKS

    load_buf_empty_bars = pargs.load_buf_empty_bars
    load_buf_full_bars = pargs.load_buf_full_bars
    load_state = Counter.create(0, load_buf_empty_bars.shape[0])

    acc_buf_empty_bars = pargs.acc_buf_empty_bars
    acc_buf_full_bars = pargs.acc_buf_full_bars
    acc_state = Counter.create(1, acc_buf_empty_bars.shape[0])

{%- if K_IS_VARYING %}
    range_layout: gl.constexpr = gl.SliceLayout(
        0,
        gl.BlockedLayout(
            size_per_thread=[1, BLOCK_K // 32],
            threads_per_warp=[1, 32],
            warps_per_cta=[1, 1],
            order=[1, 0],
            cga_layout=[],
        ),
    )
{%- endif %}

    group_iter = GroupIterator.create(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        BLOCK_M, BLOCK_N, NUM_BLOCKS
    )
    while group_iter.should_process():
        tile_iter = TileIterator.create(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            BLOCK_M, BLOCK_N, NUM_BLOCKS
        )
        while tile_iter.should_process():
            acc_buf_empty_bar = acc_buf_empty_bars.index(acc_state.index)

            _proton_enter_scope("compute_barrier_wait_acc_empty")
            mbarrier.wait(acc_buf_empty_bar, acc_state.phase)
            _proton_exit_scope("compute_barrier_wait_acc_empty")

            acc = pargs.acc_tmem_bufs.index(acc_state.index)
            use_acc = False

            for k in range(0, group_iter.k_size, BLOCK_K):
                load_buf_empty_bar = load_buf_empty_bars.index(load_state.index)
                load_buf_full_bar = load_buf_full_bars.index(load_state.index)

                _proton_enter_scope("compute_barrier_wait_load_full")
                mbarrier.wait(load_buf_full_bar, load_state.phase)
                _proton_exit_scope("compute_barrier_wait_load_full")

                _proton_enter_scope("compute_data_prep")
                a_smem = pargs.a_smem_bufs.index(load_state.index)
                b_smem = pargs.b_smem_bufs.index(load_state.index)
{%- if not A_IS_K_MAJOR %}
                a_smem = a_smem.permute((1, 0))
{%- endif %}
{%- if B_IS_K_MAJOR %}
                b_smem = b_smem.permute((1, 0))
{%- endif %}

{%- if K_IS_VARYING %}
                if k + BLOCK_K > group_iter.k_size:
                    _proton_enter_scope("mask_k_tail")
                    mask = k + gl.arange(0, BLOCK_K, layout=range_layout) < group_iter.k_size
                    a = a_smem.load(gl.AutoLayout())
                    # Only mask A, as zeroing A's columns makes
                    # corresponding B rows irrelevant.
                    a = gl.where(mask[None, :], a, 0)
                    a_smem.store(a)
                    fence_async_shared()
                    _proton_exit_scope("mask_k_tail")
{%- endif %}

                _proton_exit_scope("compute_data_prep")

                _proton_enter_scope("compute_mma")
                tcgen05_mma(a_smem, b_smem, acc, use_acc=use_acc)
                _proton_exit_scope("compute_mma")

                _proton_enter_scope("compute_commit_empty")
                tcgen05_commit(load_buf_empty_bar)
                _proton_exit_scope("compute_commit_empty")

                use_acc = True
                load_state = load_state.next()

            acc_buf_full_bar = acc_buf_full_bars.index(acc_state.index)

            _proton_enter_scope("compute_commit_acc_full")
            tcgen05_commit(acc_buf_full_bar)
            _proton_exit_scope("compute_commit_acc_full")

            acc_state = acc_state.next()

            tile_iter = tile_iter.next()

        group_iter = group_iter.next()

    _proton_exit_scope("compute_partition")


@gluon.jit
def store_partition(pargs: PartitionArgs):
    _proton_enter_scope("store_partition")

    G = pargs.G
    M = pargs.M
    N = pargs.N
    K = pargs.K
    BLOCK_M: gl.constexpr = pargs.BLOCK_M
    BLOCK_N: gl.constexpr = pargs.BLOCK_N
    NUM_BLOCKS: gl.constexpr = pargs.NUM_BLOCKS

    acc_buf_empty_bars = pargs.acc_buf_empty_bars
    acc_buf_full_bars = pargs.acc_buf_full_bars
    acc_state = Counter.create(0, acc_buf_empty_bars.shape[0])

{%- if USE_TMA_STORE %}
    c_smem = gl.allocate_shared_memory(
        pargs.c_desc.dtype, [BLOCK_M, BLOCK_N], pargs.c_smem_layout
    )
{%- endif %}

    group_iter = GroupIterator.create(
        G, M, N, K,
{%- if M_IS_VARYING or N_IS_VARYING or K_IS_VARYING %}
        pargs.offs_ptr,
{%- endif %}
        BLOCK_M, BLOCK_N, NUM_BLOCKS
    )
    while group_iter.should_process():
        tile_iter = TileIterator.create(
            group_iter.tile_idx - group_iter.tiles_processed,
            group_iter.m_start_offset, group_iter.m_size, group_iter.n_start_offset, group_iter.n_size,
            BLOCK_M, BLOCK_N, NUM_BLOCKS
        )
        while tile_iter.should_process():
            # FIXME: add epilogue here!

            acc_buf_full_bar = acc_buf_full_bars.index(acc_state.index)

            _proton_enter_scope("store_barrier_wait_acc_full")
            mbarrier.wait(acc_buf_full_bar, acc_state.phase)
            _proton_exit_scope("store_barrier_wait_acc_full")

            _proton_enter_scope("store_tmem_load")
            acc_tmem = pargs.acc_tmem_bufs.index(acc_state.index)
            acc = acc_tmem.load()
            _proton_exit_scope("store_tmem_load")

            acc_buf_empty_bar = acc_buf_empty_bars.index(acc_state.index)
            acc_state = acc_state.next()

            _proton_enter_scope("store_convert")
{%- if USE_TMA_STORE %}
            c = acc.to(pargs.c_desc.dtype)
{%- else %}
            c = acc.to(pargs.output_dtype)
{%- endif %}
            _proton_exit_scope("store_convert")

            _proton_enter_scope("store_barrier_arrive")
            mbarrier.arrive(acc_buf_empty_bar, count=1)
            _proton_exit_scope("store_barrier_arrive")

{%- if C_IS_2D %}
            _proton_enter_scope("store_masked")
            offs_m = gl.arange(0, BLOCK_M)
            offs_n = gl.arange(0, BLOCK_N)

            idx_m = (tile_iter.m_offset + offs_m).to({{ INDEX_DTYPE_EXPR }})
            idx_n = (tile_iter.n_offset + offs_n).to({{ INDEX_DTYPE_EXPR }})

            mask_m = tile_iter.m_tile_offset + offs_m < group_iter.m_size
            mask_n = tile_iter.n_tile_offset + offs_n < group_iter.n_size
            mask = mask_m[:, None] & mask_n[None, :]

            c_ptrs = pargs.c_ptr + idx_m[:, None] * pargs.c_stride_m + idx_n[None, :] * pargs.c_stride_n

            NUM_STORE_WARPS: gl.constexpr = gl.num_warps()
            store_layout: gl.constexpr = gl.BlockedLayout(
                size_per_thread=[1, BLOCK_N // 32],
                threads_per_warp=[1, 32],
                warps_per_cta=[NUM_STORE_WARPS, 1],
                order=[1, 0],
            )
            c_coalesced = gl.convert_layout(c, store_layout)
            gl.store(c_ptrs, c_coalesced, mask=mask)
            _proton_exit_scope("store_masked")
{%- else %}
            _proton_enter_scope("store_tma_wait")
            tma.store_wait(pendings=0)
            _proton_exit_scope("store_tma_wait")

            _proton_enter_scope("store_smem_write")
            c_smem.store(c)
            _proton_exit_scope("store_smem_write")

            _proton_enter_scope("store_fence_and_tma")
            fence_async_shared()
            tma.async_copy_shared_to_global(pargs.c_desc, [group_iter.g, tile_iter.m_offset, tile_iter.n_offset], c_smem)
            _proton_exit_scope("store_fence_and_tma")
{%- endif %}

            tile_iter = tile_iter.next()

        group_iter = group_iter.next()

{%- if USE_TMA_STORE %}
    _proton_enter_scope("store_final_tma_wait")
    tma.store_wait(pendings=0)
    _proton_exit_scope("store_final_tma_wait")
{%- endif %}

    _proton_exit_scope("store_partition")


