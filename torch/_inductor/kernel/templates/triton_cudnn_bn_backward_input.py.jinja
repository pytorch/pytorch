{{def_kernel("X", "G", "W", "M", "I", "P")}}
    batch = tl.full((), {{size("X", 0, runtime=True)}}, tl.int32)
    spatial = tl.full((), 1, tl.int32)
    {% for dimension in range(2, RANK) %}
    spatial = spatial * {{size("X", dimension, runtime=True)}}
    {% endfor %}
    index = (tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)).to(INDEX_DTYPE)
    valid = index < batch * C * spatial
    {% if CHANNELS_LAST %}
    sample = index // C
    channel = index % C
    n = sample // spatial
    tail = sample % spatial
    {% else %}
    channel = (index // spatial) % C
    n = index // (C * spatial)
    tail = index % spatial
    sample = n * spatial + tail
    {% endif %}
    value = tl.load(X + index, valid, other=0).to(ACC_TYPE)
    grad = tl.load(G + index, valid, other=0).to(ACC_TYPE)
    mean = tl.load(M + channel)
    invstd = tl.load(I + channel)
    weight = tl.load(W + channel)
    total = tl.load(P + channel)
    dot = tl.load(P + C + channel)
    scale = triton_helpers.libdevice.div_rn(tl.full((), 1, ACC_TYPE), (batch * spatial).to(ACC_TYPE))
    {% if CHANNELS_LAST %}
    coefficient = ((dot * invstd) * invstd) * scale
    factor = weight * invstd
    {% if STREAMED %}
    cached = (VEC == 4) | (sample < batch * spatial - PARTS * EXTRA * (512 * VEC // TILE))
    centered_grad = tl.where(cached, tl.fma(-total, scale, grad), grad - total * scale)
    {% else %}
    centered_grad = grad - total * scale
    {% endif %}
    output = tl.fma(-coefficient, value - mean, centered_grad) * factor
    {% elif SINGLE %}
    coefficient = (invstd * (invstd * dot)) * scale
    factor = invstd * weight
    centered_grad = total * scale
    scaled_coefficient = factor * coefficient
    {% if VEC == 2 %}
    offset = factor * tl.fma(mean, coefficient, -centered_grad)
    output = tl.fma(factor, grad, (-scaled_coefficient) * value) + offset
    {% else %}
    output = tl.fma(-scaled_coefficient, value - mean, tl.fma(factor, grad, -(factor * centered_grad)))
    {% endif %}
    {% else %}
    coefficient = ((scale * dot) * invstd) * invstd
    output = (tl.fma(-coefficient, value - mean, grad) - scale * total) * invstd
    output = weight * output
    {% endif %}
    {% for dimension in range(RANK - 1, 1, -1) %}
    i{{dimension}} = tail % {{size("X", dimension)}}
    tail = tail // {{size("X", dimension)}}
    {% endfor %}
    {{store_output(OUTPUT_INDICES, "output", "valid", val_shape=("BLOCK",))}}
