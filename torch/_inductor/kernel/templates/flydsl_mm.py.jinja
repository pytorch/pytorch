    output = {{get_output()}}
    global _gemm_executor, _gemm_param
{% if MAT2_IS_NK %}
    # The lowering passes the original contiguous B buffer for A @ B.T.
    mat2_nk = mat2
{% else %}
    mat2_nk = mat2.transpose(0, 1)
{% endif %}
    executor = _gemm_executor
    if executor is not None:
        executor(
            output,
            mat1,
            mat2_nk,
            GEMM_M,
            GEMM_N,
            GEMM_K,
            _gemm_param,
            stream,
