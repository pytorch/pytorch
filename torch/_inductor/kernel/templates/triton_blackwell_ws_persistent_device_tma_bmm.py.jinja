{{def_kernel("A", "B")}}
    BATCH = {{size("A", 0)}}
    M = {{size("A", 1)}}
    N = {{size("B", 2)}}
    K = {{size("A", 2)}}
    if M == 0 or N == 0:
        return

    stride_ab = {{stride("A", 0)}}
    stride_bb = {{stride("B", 0)}}

    stride_am = {{stride("A", 1)}}
    stride_ak = {{stride("A", 2)}}
    stride_bk = {{stride("B", 1)}}
    stride_bn = {{stride("B", 2)}}

    # Non-broadcast operands use rank-3 descriptors so one persistent worker
    # can move between logical batches.  A zero batch stride cannot be encoded
    # by TMA, so broadcast operands retain one shared rank-2 descriptor.
    {%- if A_BROADCAST_BATCH %}
    a_desc = triton.language.make_tensor_descriptor(
        base=A,
        shape=[M, K] if A_ROW_MAJOR else [K, M],
        strides=[stride_am, 1] if A_ROW_MAJOR else [stride_ak, 1],
        block_shape=[BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M],
    )
    {%- else %}
    a_desc = triton.language.make_tensor_descriptor(
        base=A,
        shape=[BATCH, M, K] if A_ROW_MAJOR else [BATCH, K, M],
        strides=[stride_ab, stride_am, 1] if A_ROW_MAJOR else [stride_ab, stride_ak, 1],
        block_shape=[1, BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [1, BLOCK_K, BLOCK_M],
    )
    {%- endif %}
    {%- if B_BROADCAST_BATCH %}
    b_desc = triton.language.make_tensor_descriptor(
        base=B,
        shape=[K, N] if B_ROW_MAJOR else [N, K],
        strides=[stride_bk, 1] if B_ROW_MAJOR else [stride_bn, 1],
        block_shape=[BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
    )
    {%- else %}
    b_desc = triton.language.make_tensor_descriptor(
        base=B,
        shape=[BATCH, K, N] if B_ROW_MAJOR else [BATCH, N, K],
        strides=[stride_bb, stride_bk, 1] if B_ROW_MAJOR else [stride_bb, stride_bn, 1],
        block_shape=[1, BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [1, BLOCK_N, BLOCK_K],
    )
    {%- endif %}

    start_pid = tl.program_id(0)
    grid_m = tl.cdiv(M, BLOCK_M)
    grid_n = tl.cdiv(N, BLOCK_N)
    num_tiles_per_batch = grid_m * grid_n
    num_tiles = BATCH * num_tiles_per_batch
    num_pid_in_group = GROUP_M * grid_n
    k_tiles = tl.cdiv(K, BLOCK_K)
    # Track the epilogue tile separately to break its dependency on the
    # prologue's loop induction variable (as in the Blackwell MM template).
    tile_id_c = start_pid - NUM_SMS

    {%- if USE_META_WS %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
        data_partition_factor=DATA_PARTITION_FACTOR,
        separate_epilogue_store=SEPARATE_EPILOGUE_STORE,
    ):
    {%- else %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
    ):
    {%- endif %}
        batch = tile_id // num_tiles_per_batch
        batch_tile_id = tile_id % num_tiles_per_batch
        pid_m, pid_n = _blackwell_bmm_pid(
            batch_tile_id, num_pid_in_group, grid_m, GROUP_M
        )
        offs_am = (pid_m * BLOCK_M).to(tl.int32)
        offs_bn = (pid_n * BLOCK_N).to(tl.int32)
        accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
        for ki in range(k_tiles):
            offs_k = (ki * BLOCK_K).to(tl.int32)
            a = a_desc.load(
                {%- if A_BROADCAST_BATCH %}
                [offs_am, offs_k] if A_ROW_MAJOR else [offs_k, offs_am],
                {%- else %}
                [batch, offs_am, offs_k] if A_ROW_MAJOR else [batch, offs_k, offs_am],
                {%- endif %}
            )
            {%- if not A_BROADCAST_BATCH %}
            a = a.reshape((BLOCK_M, BLOCK_K) if A_ROW_MAJOR else (BLOCK_K, BLOCK_M))
            {%- endif %}
            b = b_desc.load(
                {%- if B_BROADCAST_BATCH %}
                [offs_k, offs_bn] if B_ROW_MAJOR else [offs_bn, offs_k],
                {%- else %}
                [batch, offs_k, offs_bn] if B_ROW_MAJOR else [batch, offs_bn, offs_k],
                {%- endif %}
            )
            {%- if not B_BROADCAST_BATCH %}
            b = b.reshape((BLOCK_K, BLOCK_N) if B_ROW_MAJOR else (BLOCK_N, BLOCK_K))
            {%- endif %}
            accumulator += tl.dot(
                a if A_ROW_MAJOR else a.T,
                b if B_ROW_MAJOR else b.T,
                allow_tf32=ALLOW_TF32,
            )

        tile_id_c += NUM_SMS
        batch = tile_id_c // num_tiles_per_batch
        batch_tile_id = tile_id_c % num_tiles_per_batch
        pid_m, pid_n = _blackwell_bmm_pid(
            batch_tile_id, num_pid_in_group, grid_m, GROUP_M
        )
        offs_cm = pid_m * BLOCK_M
        offs_cn = pid_n * BLOCK_N
        subtiles = _subtile_accumulator(
            accumulator, BLOCK_M, BLOCK_N, EPILOGUE_SUBTILE
        )
        for i in tl.static_range(EPILOGUE_SUBTILE):
            offs_cn_i = offs_cn + i * (BLOCK_N // EPILOGUE_SUBTILE)
            rm = offs_cm + tl.arange(0, BLOCK_M)[:, None]
            rn = offs_cn_i + tl.arange(0, BLOCK_N // EPILOGUE_SUBTILE)[None, :]
            mask = (rm < M) & (rn < N)
            {{store_output(
                ("batch", "rm", "rn"),
                "subtiles[i]",
                "mask",
                indent_width=12,
                val_shape=("BLOCK_M", "BLOCK_N // EPILOGUE_SUBTILE")
            )}}


@triton.jit
def _blackwell_bmm_pid(tile_id, num_pid_in_group, grid_m, GROUP_M: tl.constexpr):
    group_id = tile_id // num_pid_in_group
    first_pid_m = group_id * GROUP_M
    group_m = min(grid_m - first_pid_m, GROUP_M)
    pid_m = first_pid_m + tile_id % group_m
    pid_n = (tile_id % num_pid_in_group) // group_m
    return pid_m, pid_n


@triton.jit
def _subtile_accumulator(
    acc,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
    SUBTILE_FACTOR: tl.constexpr,
):
    tl.static_assert(SUBTILE_FACTOR > 0, "SUBTILE_FACTOR must be positive")
    tl.static_assert(
        (SUBTILE_FACTOR & (SUBTILE_FACTOR - 1)) == 0,
        "SUBTILE_FACTOR must be a power of 2",
    )

    if SUBTILE_FACTOR == 1:
        return (acc,)
    else:
        tl.static_assert(BLOCK_N % 2 == 0)
        acc = tl.reshape(acc, (BLOCK_M, 2, BLOCK_N // 2))
        acc = tl.permute(acc, (0, 2, 1))
        left, right = tl.split(acc)
        left_subtiles = _subtile_accumulator(
            left, BLOCK_M, BLOCK_N // 2, SUBTILE_FACTOR // 2
        )
        right_subtiles = _subtile_accumulator(
            right, BLOCK_M, BLOCK_N // 2, SUBTILE_FACTOR // 2
        )
        return left_subtiles + right_subtiles
