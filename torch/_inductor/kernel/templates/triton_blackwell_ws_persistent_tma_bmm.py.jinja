{{def_kernel("A", "B")}}
    BATCH = BATCH_SIZE
    M = LOGICAL_M
    N = LOGICAL_N
    K = DESCRIPTOR_K
    if M == 0 or N == 0:
        return

    # Non-broadcast operands use rank-3 descriptors so one persistent worker
    # can move between physical batches; tma_descriptor() builds them on the
    # host when HOST_SIDE_TMA is set. Broadcast operands and decompose-K's
    # virtual batches retain one shared device-side rank-2 descriptor.
    {%- if VIRTUAL_BATCH %}
    {{unfused_input(
        "A",
        "a_desc = triton.language.make_tensor_descriptor(base=A, shape=" + ("[M, K]" if A_ROW_MAJOR else "[K, M]") + ", strides=" + ("[A_M_STRIDE, 1]" if A_ROW_MAJOR else "[A_K_STRIDE, 1]") + ", block_shape=" + ("[BLOCK_M, BLOCK_K]" if A_ROW_MAJOR else "[BLOCK_K, BLOCK_M]") + ")",
        indent_width=4,
    )}}
    {%- elif A_BROADCAST_BATCH %}
    a_desc = triton.language.make_tensor_descriptor(
        base=A,
        shape=[M, K] if A_ROW_MAJOR else [K, M],
        strides=[A_M_STRIDE, 1] if A_ROW_MAJOR else [A_K_STRIDE, 1],
        block_shape=[BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M],
    )
    {%- else %}
    {{tma_descriptor("a_desc", "A",
        [1, BLOCK_M, BLOCK_K] if A_ROW_MAJOR else [1, BLOCK_K, BLOCK_M],
        [0, 1, 2] if A_ROW_MAJOR else [0, 2, 1]
    )}}
    {%- endif %}
    {%- if VIRTUAL_BATCH and (B_ROW_MAJOR or not TWO_CTAS) %}
    {{unfused_input(
        "B",
        "b_desc = triton.language.make_tensor_descriptor(base=B, shape=" + ("[K, N]" if B_ROW_MAJOR else "[N, K]") + ", strides=" + ("[B_K_STRIDE, 1]" if B_ROW_MAJOR else "[B_N_STRIDE, 1]") + ", block_shape=" + ("[BLOCK_K, BLOCK_N]" if B_ROW_MAJOR else "[BLOCK_N, BLOCK_K]") + ")",
        indent_width=4,
    )}}
    {%- elif VIRTUAL_BATCH or B_BROADCAST_BATCH %}
    b_desc = triton.language.make_tensor_descriptor(
        base=B,
        shape=[K, N] if B_ROW_MAJOR else [N, K],
        strides=[B_K_STRIDE, 1] if B_ROW_MAJOR else [B_N_STRIDE, 1],
        block_shape=[BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
    )
    {%- else %}
    {{tma_descriptor("b_desc", "B",
        [1, BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [1, BLOCK_N, BLOCK_K],
        [0, 1, 2] if B_ROW_MAJOR else [0, 2, 1]
    )}}
    {%- endif %}

    start_pid = tl.program_id(0)
    grid_m = tl.cdiv(M, BLOCK_M)
    {%- if TWO_CTAS %}
    grid_m = tl.cdiv(grid_m, 2) * 2
    {%- endif %}
    grid_n = tl.cdiv(N, BLOCK_N)
    num_tiles_per_batch = grid_m * grid_n
    num_tiles = BATCH * num_tiles_per_batch
    num_pid_in_group = GROUP_M * grid_n
    {%- if USE_META_WS %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
        data_partition_factor=DATA_PARTITION_FACTOR,
        separate_epilogue_store=SEPARATE_EPILOGUE_STORE,
    ):
    {%- else %}
    for tile_id in tl.range(
        start_pid,
        num_tiles,
        NUM_SMS,
        flatten=FLATTEN,
        warp_specialize=WARP_SPECIALIZE,
    ):
    {%- endif %}
        batch = tile_id // num_tiles_per_batch
        batch_tile_id = tile_id % num_tiles_per_batch
        pid_m, pid_n = _compute_pid(
            batch_tile_id, num_pid_in_group, grid_m, GROUP_M
        )
        offs_am = (pid_m * BLOCK_M).to(tl.int32)
        offs_bn = (pid_n * BLOCK_N).to(tl.int32)
        accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
        for ki in range(K_TILES):
            k_base = batch * K_BATCH_OFFSET
            offs_k = (k_base + ki * BLOCK_K).to(tl.int32)
            # A fused producer reads its own sources through TMA (see
            # load_prologue_descriptor), so a is in operand order. A broadcast
            # A is a rank-3 view with a zero batch stride; it is not fusable.
            {%- if A_BROADCAST_BATCH and not VIRTUAL_BATCH %}
            a = a_desc.load([offs_am, offs_k] if A_ROW_MAJOR else [offs_k, offs_am])
            {%- if not A_ROW_MAJOR %}
            a = a.T
            {%- endif %}
            {%- elif VIRTUAL_BATCH %}
            a_m = offs_am + tl.arange(0, BLOCK_M)[:, None]
            a_k = offs_k + tl.arange(0, BLOCK_K)[None, :]
            {{load_input(
                "A",
                "a",
                ("a_m", "a_k"),
                mask="(a_m < M) & (a_k < K)",
                indent_width=12,
                index_shape=("BLOCK_M", "BLOCK_K"),
                unfused_load="a_desc.load([offs_am, offs_k])" if A_ROW_MAJOR else "a_desc.load([offs_k, offs_am]).T",
                prologue_descriptor_offsets=("offs_am", "offs_k"),
                prologue_descriptor_block_shape=("BLOCK_M", "BLOCK_K"),
            )}}
            {%- else %}
            a_b = batch + tl.arange(0, 1)[:, None, None]
            a_m = offs_am + tl.arange(0, BLOCK_M)[None, :, None]
            a_k = offs_k + tl.arange(0, BLOCK_K)[None, None, :]
            {{load_input(
                "A",
                "a",
                ("a_b", "a_m", "a_k"),
                mask="(a_m < M) & (a_k < K)",
                indent_width=12,
                index_shape=("1", "BLOCK_M", "BLOCK_K"),
                unfused_load="a_desc.load([batch, offs_am, offs_k])" if A_ROW_MAJOR else "tl.permute(a_desc.load([batch, offs_k, offs_am]), (0, 2, 1))",
                prologue_descriptor_offsets=("batch", "offs_am", "offs_k"),
                prologue_descriptor_block_shape=("1", "BLOCK_M", "BLOCK_K"),
            )}}
            a = a.reshape((BLOCK_M, BLOCK_K))
            {%- endif %}
            {%- if B_BROADCAST_BATCH or (TWO_CTAS and not (VIRTUAL_BATCH and B_ROW_MAJOR)) %}
            # The 2-CTA MMA splits B across the cluster from shared memory, so
            # B cannot be built in registers by a fused producer; a broadcast B
            # is a rank-3 view with a zero batch stride.
            b = b_desc.load(
                {%- if VIRTUAL_BATCH or B_BROADCAST_BATCH %}
                [offs_k, offs_bn] if B_ROW_MAJOR else [offs_bn, offs_k],
                {%- else %}
                [batch, offs_k, offs_bn] if B_ROW_MAJOR else [batch, offs_bn, offs_k],
                {%- endif %}
            )
            {%- if not VIRTUAL_BATCH and not B_BROADCAST_BATCH %}
            b = b.reshape((BLOCK_K, BLOCK_N) if B_ROW_MAJOR else (BLOCK_N, BLOCK_K))
            {%- endif %}
            {%- if not B_ROW_MAJOR %}
            b = b.T
            {%- endif %}
            {%- elif VIRTUAL_BATCH %}
            b_k = offs_k + tl.arange(0, BLOCK_K)[:, None]
            b_n = offs_bn + tl.arange(0, BLOCK_N)[None, :]
            {{load_input(
                "B",
                "b",
                ("b_k", "b_n"),
                mask="(b_k < K) & (b_n < N)",
                other=0.0,
                indent_width=12,
                index_shape=("BLOCK_K", "BLOCK_N"),
                unfused_load="b_desc.load([offs_k, offs_bn])" if B_ROW_MAJOR else "b_desc.load([offs_bn, offs_k]).T",
                prologue_descriptor_offsets=("offs_k", "offs_bn") if not TWO_CTAS else None,
                prologue_descriptor_block_shape=("BLOCK_K", "BLOCK_N") if not TWO_CTAS else None,
                prologue_descriptor_cat2=(B_ROW_MAJOR and LOGICAL_N == 128 and BLOCK_N == 128),
            )}}
            {%- else %}
            b_b = batch + tl.arange(0, 1)[:, None, None]
            b_k = offs_k + tl.arange(0, BLOCK_K)[None, :, None]
            b_n = offs_bn + tl.arange(0, BLOCK_N)[None, None, :]
            {{load_input(
                "B",
                "b",
                ("b_b", "b_k", "b_n"),
                mask="(b_k < K) & (b_n < N)",
                indent_width=12,
                index_shape=("1", "BLOCK_K", "BLOCK_N"),
                unfused_load="b_desc.load([batch, offs_k, offs_bn])" if B_ROW_MAJOR else "tl.permute(b_desc.load([batch, offs_bn, offs_k]), (0, 2, 1))",
                prologue_descriptor_offsets=("batch", "offs_k", "offs_bn"),
                prologue_descriptor_block_shape=("1", "BLOCK_K", "BLOCK_N"),
            )}}
            b = b.reshape((BLOCK_K, BLOCK_N))
            {%- endif %}
            accumulator += tl.dot(
                a,
                b,
                allow_tf32=ALLOW_TF32,
                {%- if TWO_CTAS %}
                two_ctas=True,
                {%- endif %}
            )

        batch = tile_id // num_tiles_per_batch
        batch_tile_id = tile_id % num_tiles_per_batch
        pid_m, pid_n = _compute_pid(
            batch_tile_id, num_pid_in_group, grid_m, GROUP_M
        )
        offs_cm = pid_m * BLOCK_M
        offs_cn = pid_n * BLOCK_N
        subtiles = _subtile_accumulator(
            accumulator, BLOCK_M, BLOCK_N, EPILOGUE_SUBTILE
        )
        for i in tl.static_range(EPILOGUE_SUBTILE):
            offs_cn_i = offs_cn + i * (BLOCK_N // EPILOGUE_SUBTILE)
            {%- if FLATTEN_OUTPUT %}
            output_row = batch * OUTPUT_BATCH_ROWS + offs_cm
            {{store_output(
                ("output_row", "offs_cn_i"),
                "subtiles[i]",
                indent_width=12,
                val_shape=("BLOCK_M", "BLOCK_N // EPILOGUE_SUBTILE"),
                block_indexing=True
            )}}
            {%- elif RANK3_TMA_OUTPUT %}
            # The leading block dim is always 1: each tile maps to exactly one batch.
            output_subtile = subtiles[i].reshape(
                (1, BLOCK_M, BLOCK_N // EPILOGUE_SUBTILE)
            )
            {{store_output(
                ("batch", "offs_cm", "offs_cn_i"),
                "output_subtile",
                indent_width=12,
                val_shape=("1", "BLOCK_M", "BLOCK_N // EPILOGUE_SUBTILE"),
                block_indexing=True
            )}}
            {%- else %}
            rm = offs_cm + tl.arange(0, BLOCK_M)[:, None]
            rn = offs_cn_i + tl.arange(0, BLOCK_N // EPILOGUE_SUBTILE)[None, :]
            mask = (rm < M) & (rn < N)
            {{store_output(
                ("batch", "rm", "rn"),
                "subtiles[i]",
                "mask",
                indent_width=12,
                val_shape=("BLOCK_M", "BLOCK_N // EPILOGUE_SUBTILE")
            )}}
            {%- endif %}
