import threading

from torch._inductor.kernel.vendored_templates.flydsl.kernels import (
    launch_mxfp8_wgrad_gfx950,
    make_mxfp8_wgrad_param,
)
from torch._inductor.runtime.flydsl_cache import (
    configure_flydsl_cache_dir,
    flydsl_tensor_arg,
    precompile_flydsl,
)

{{gen_defines()}}


_mxfp8_wgrad_params = {}
_mxfp8_wgrad_param_lock = threading.Lock()


def _flydsl_mxfp8_wgrad(
    output, mat1, mat2, scale_a, scale_b, offs, stream, compile_only=False
):
    m = mat1.shape[1]
    # The lowering matched M only by hint; a shorter operand would be overread.
    if (
        mat2.shape[0] != m
        or tuple(scale_a.shape) != (mat1.shape[0], m // 32)
        or tuple(scale_b.shape) != (mat2.shape[1], m // 32)
    ):
        raise ValueError(
            f"MXFP8 wgrad operands disagree on the contraction: mat1 "
            f"{tuple(mat1.shape)}, mat2 {tuple(mat2.shape)}, scale_a "
            f"{tuple(scale_a.shape)}, scale_b {tuple(scale_b.shape)}"
        )
    if m == 0:
        # No routed tokens: zero gradients, without zero-element FlyDSL operands.
        return output.zero_()
    sc_pair = m % 256 == 0
    param = _mxfp8_wgrad_params.get(sc_pair)
    if param is None:
        with _mxfp8_wgrad_param_lock:
            param = _mxfp8_wgrad_params.get(sc_pair)
            if param is None:
                param = make_mxfp8_wgrad_param(
                    GEMM_N, GEMM_K, GEMM_G, sc_pair=sc_pair, num_xcd=NUM_XCD
                )
                _mxfp8_wgrad_params[sc_pair] = param

    # mat2 is column-major [M, K]: its transpose is the row-major [K, M] view.
    configure_flydsl_cache_dir()
    launch_mxfp8_wgrad_gfx950(
        output, mat1, mat2.permute(1, 0), scale_a, scale_b, offs, param, stream,
        tensor_arg=flydsl_tensor_arg, compile_only=compile_only,
    )
    return output


{{def_kernel("mat1", "mat2", "scale_a", "scale_b", "offs")}}
    output = {{get_output()}}
    return _flydsl_mxfp8_wgrad(output, mat1, mat2, scale_a, scale_b, offs, stream)


def {{kernel_name}}_precompile(
    precompile_shapes,
    precompile_strides,
    precompile_dtypes,
    device_index=0,
    device_capability=None,
    flydsl_gpu_arch=None,
):
    precompile_flydsl(
        _flydsl_mxfp8_wgrad, precompile_shapes, precompile_strides,
        precompile_dtypes, flydsl_gpu_arch,
    )
