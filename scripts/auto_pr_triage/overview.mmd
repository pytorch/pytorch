%% Auto PR Triage user-facing decision flow.
%% Regenerate from the repository root:
%% npx -y @mermaid-js/mermaid-cli@10.9.1 -i scripts/auto_pr_triage/overview.mmd -o scripts/auto_pr_triage/overview.svg -b transparent
%%{init: {"theme": "neutral", "themeCSS": ".nodeLabel, span.edgeLabel { display: inline-block; padding: 3px 12px 5px 3px; } .label foreignObject { overflow: visible; }", "flowchart": {"curve": "linear", "diagramPadding": 24, "htmlLabels": true, "nodeSpacing": 25, "padding": 24, "rankSpacing": 30}}}%%
flowchart TB
  START["<div style='text-align:center'><b>When Auto PR Triage runs</b></div><div style='text-align:left;margin-top:8px;padding-right:20px;white-space:nowrap'>For an open pull request targeting <b>main</b> with no prior Auto PR Triage outcome:<br/>First application of the 'open source' label while ready for review<br/><b>OR</b> first time a pull request already carrying that label moves from draft to ready for review</div>"]

  ENTRY("<div style='text-align:center'><b>Does the pull request meet repository policy?</b></div><div style='text-align:left;margin-top:8px'>The pull request closes (Fixes/Closes/Resolves) a same-repository issue marked 'actionable'<br/><b>OR</b> the author has triage+ permission for this repository<br/><b>OR</b> a triage+ maintainer took deliberate action on the pull request<br/><b>OR</b> the description says 'Supported by @login' for a triage+ maintainer, who is requested as a reviewer<br/><b>OR</b> the description says 'Part of #N' for a same-repository issue marked 'actionable'<br/><b>OR</b> the ownership analysis found that the change matches a team's bypass intake criteria</div>")
  MISSING_ISSUE["Add triaged, bot-triaged, and<br/>'missing actionable issue'"]
  NOT_ADMITTED_DOUBT("Did the LLM call fail, or was a bypass<br/>claim too uncertain to accept?")
  KEEP_OPEN["Keep the pull request open<br/>Report the failed LLM call, if any<br/>Defer to a human triager"]

  OWNERSHIP["<div style='text-align:center'><b>Ownership analysis</b></div><div style='text-align:center'>Runs for every pull request that reaches this point</div><div style='text-align:left;margin-top:8px'>1. <b>Codepath ownership:</b> Match changed files to rules in<br/><span style='display:inline-block;padding-left:1em'>the repository's <code>CODEOWNERS</code> file.</span><br/><br/>2. <b>Semantic ownership:</b> Use an LLM and descriptions in<br/><span style='display:inline-block;padding-left:1em'><code>.github/auto-pr-triage/extra_ownership_metadata.json</code></span><br/><span style='display:inline-block;padding-left:1em'>to add ownership areas based on what the change does.</span><br/><br/>3. <b>Bypass intake:</b> The same LLM call judges whether the change<br/><span style='display:inline-block;padding-left:1em'>matches a team's <code>bypass_intake_criteria</code> in that file.</span></div>"]
  HAS_OWNERS("Were any codepath or<br/>semantic owners found?")

  REVIEW_PLAN["<div style='text-align:center'><b>Resolve owners to reviewer targets</b></div><div style='text-align:left;margin-top:8px'>Ownership analysis produces two types of owners:<br/><br/><b>Direct GitHub targets:</b> <code>@user</code> and <code>@org/team</code> handles<br/>are already reviewer targets.<br/><br/><b>Team owner IDs:</b> Resolve each ID through its roster in<br/><code>.github/auto-pr-triage/team_members.json</code>. A roster member<br/>already covering the pull request as a direct codepath owner,<br/>submitted reviewer, or pending reviewer satisfies the team.<br/>Otherwise, pick a member at random, seeded by the pull request.</div>"]
  ROUTING_FAILED("Did the LLM call fail, or does<br/>any team owner lack a reviewer?")
  COVERED("Are all material concerns covered?")
  HANDOFF("<div style='text-align:center'><b>Is there a handoff reviewer?</b></div><div style='text-align:left;margin-top:8px'>A verified 'Supported by @login' maintainer<br/><b>OR</b> a triage+ maintainer who marked the issue 'actionable'<br/><b>OR</b> a reviewer requested by another triage+ maintainer<br/>Codepath and semantic owners do not count</div>")

  ANALYSIS_FAILED("Did the LLM call fail?")
  HUMAN_TRIAGE["Do not mark as triaged<br/>Defer to a human triager"]
  ANALYSIS_INCOMPLETE["Do not mark as triaged<br/>Report that semantic owners are missing<br/>Defer to a human triager"]
  ROUTING_INCOMPLETE["Do not mark as triaged<br/>Continue with any safely resolved reviewers<br/>Report missing semantic owners or team owners<br/>without a reviewer for human follow-up"]

  ROUTED["Mark as triaged<br/>Request the selected reviewers, supporters, and issue labelers<br/>A handoff reviewer pulls in others for any uncovered concerns"]

  START --> OWNERSHIP
  OWNERSHIP --> ENTRY

  ENTRY -- No --> NOT_ADMITTED_DOUBT
  NOT_ADMITTED_DOUBT -- No --> MISSING_ISSUE
  NOT_ADMITTED_DOUBT -- Yes --> KEEP_OPEN

  ENTRY -- Yes --> HAS_OWNERS
  HAS_OWNERS -- No --> ANALYSIS_FAILED
  ANALYSIS_FAILED -- Yes --> ANALYSIS_INCOMPLETE
  ANALYSIS_FAILED -- No --> HANDOFF

  HAS_OWNERS -- Yes --> REVIEW_PLAN
  REVIEW_PLAN --> ROUTING_FAILED
  ROUTING_FAILED -- No --> COVERED
  ROUTING_FAILED -- Yes --> ROUTING_INCOMPLETE
  COVERED -- No --> HANDOFF
  COVERED -- Yes --> ROUTED
  HANDOFF -- No --> HUMAN_TRIAGE
  HANDOFF -- Yes --> ROUTED

  classDef start fill:#ddf4ff,stroke:#0969da,color:#24292f,stroke-width:2px
  classDef decision fill:#fff8c5,stroke:#9a6700,color:#24292f,stroke-width:2px
  classDef work fill:#ddf4ff,stroke:#0969da,color:#24292f,stroke-width:2px
  classDef missing fill:#ffebe9,stroke:#cf222e,color:#24292f,stroke-width:2px
  classDef triaged fill:#dafbe1,stroke:#1a7f37,color:#24292f,stroke-width:2px
  classDef followup fill:#fff1e5,stroke:#bc4c00,color:#24292f,stroke-width:2px

  class START start
  class ENTRY,NOT_ADMITTED_DOUBT,HAS_OWNERS,ANALYSIS_FAILED,ROUTING_FAILED,COVERED,HANDOFF decision
  class OWNERSHIP,REVIEW_PLAN work
  class MISSING_ISSUE missing
  class ROUTED triaged
  class ANALYSIS_INCOMPLETE,ROUTING_INCOMPLETE,HUMAN_TRIAGE,KEEP_OPEN followup
