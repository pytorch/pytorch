def get_commit_hashes(pr_id, token):
    owner = "pytorch"
    repo = "pytorch"
    commits_url = f"https://api.github.com/repos/{owner}/{repo}/pulls/{pr_id}/commits"
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json"
    }
    page = 1
    commits = []
    while True:
        response = requests.get(commits_url, headers=headers, params={'page': page})
        if response.status_code == 200:
            new_commits = response.json()
            if not new_commits:
                break
            commits.extend(new_commits)
            page += 1
        else:
            print(f"Failed to fetch commits: {response.status_code}")
            break
    return commits

def get_latest_commit_sha(pr_id, token):
    commits = get_commit_hashes(pr_id, token)
    if commits:
        return commits[-1]['sha']
    else:
        print("No commits found for the given pull request.")
        sys.exit(1)

def write_test_log_to_file(filename, test_key, jobs, sha):
    js = [j for j in jobs if test_key in j['name'] and not _is_variant_job(j['name'])]
    if len(js) > 0:
        if len(js) > 1:
            print(f"WARNING: Found multiple jobs with key: '{test_key}', selecting first one")
            for j in js:
                print(j['name'])
        test_id = js[0]['id']
        print(f"key: {test_key}, job Name: {js[0]['name']}, job ID: {test_id}, Downloading to {filename}")
    else:
        # Not being able to download logs is not a fatal error since we primarily depend on xml artifacts
        # so log error and continue
        error_msg = f"Error: TEST KEY: {test_key} DOES NOT EXIST IN JOBS.\nCheck url - https://hud.pytorch.org/hud/pytorch/pytorch/{sha}/1?per_page=50 - for job name"
        print(error_msg)
        error_msgs.append(error_msg)
        return
    response = requests.get( "https://ossci-raw-job-status.s3.amazonaws.com/log/" + str(test_id) )
    with open(filename, "w", encoding="utf-8") as f:
        f.write(response.text)

    # Save the upstream pytorch CI job's page URL next to the log so
    # detect_log_failures.py can later surface it as a link in the
    # LOG-BASED FAILURES table of the parity summary.
    job_url = js[0].get('html_url', '')
    if job_url:
        with open(filename + ".job_url", "w", encoding="utf-8") as f:
            f.write(job_url)

# GitHub's max is 100, but large pytorch trunk runs often 502 at that size,
# sometimes on every retry. Smaller pages fail less, so fall back on exhaustion.
JOBS_PAGE_SIZES = (50, 25, 10)
JOBS_PAGE_RETRIES = 5

def _fetch_jobs_page(jobs_url, params, max_retries=7):
    """GET one page of the jobs API, retrying transient failures.

    When many parity runs fire at once they hammer the jobs API and GitHub
    responds with 403 (secondary rate limit) or 5xx. GitHub can also drop a
    connection mid-body under the same load. Retry every transient failure.
    """
    last_failure = None
    for attempt in range(max_retries):
        retry_after = None
        try:
            response = requests.get(
                jobs_url, headers=authentication_headers, params=params
            )
            if response.status_code == 200:
                response_json = response.json()
                if "jobs" in response_json:
                    return response_json
            last_failure = f"HTTP {response.status_code}"
            retry_after = response.headers.get("Retry-After")
        except requests.exceptions.RequestException as error:
            last_failure = type(error).__name__
        if attempt == max_retries - 1:
            break
        delay = int(retry_after) if retry_after and retry_after.isdigit() else 2 ** attempt
        print(f"  WARNING: jobs API request failed ({last_failure}) for {jobs_url} "
              f"(attempt {attempt + 1}/{max_retries}); retrying in {delay}s")
        time.sleep(delay)
    raise Exception(
        f"jobs API did not return a 'jobs' payload after {max_retries} attempts "
        f"(last {last_failure}) for {jobs_url}"
    )

def _fetch_workflow_runs(workflow, params, max_retries=7):
    """List workflow runs without turning API failures into an empty result."""
    url = (
        "https://api.github.com/repos/pytorch/pytorch/actions/workflows/"
        f"{workflow}.yml/runs"
    )
    last_failure = None
    for attempt in range(max_retries):
        retry_after = None
        try:
            response = requests.get(
                url, headers=authentication_headers, params=params
            )
            if response.status_code == 200:
                response_json = response.json()
                if "workflow_runs" in response_json:
                    return response_json["workflow_runs"]
            last_failure = f"HTTP {response.status_code}"
            retry_after = response.headers.get("Retry-After")
        except requests.exceptions.RequestException as error:
            last_failure = type(error).__name__
        if attempt == max_retries - 1:
            break
        delay = int(retry_after) if retry_after and retry_after.isdigit() else 2 ** attempt
        print(
            f"  WARNING: workflow-runs API request failed ({last_failure}) "
            f"for {workflow}.yml (attempt {attempt + 1}/{max_retries}); "
            f"retrying in {delay}s"
        )
        time.sleep(delay)
    raise Exception(
        "workflow-runs API did not return a 'workflow_runs' payload after "
        f"{max_retries} attempts (last {last_failure}) for {workflow}.yml"
    )

def _fetch_all_jobs(jobs_url, page_size, all_attempts):
    base_params = {'per_page': page_size}
    if all_attempts:
        base_params['filter'] = 'all'
    response_json = _fetch_jobs_page(jobs_url, base_params, JOBS_PAGE_RETRIES)
    jobs = response_json["jobs"]
    for i in range(2, math.ceil(response_json['total_count'] / page_size) + 1):
        page_json = _fetch_jobs_page(
            jobs_url, {**base_params, 'page': i}, JOBS_PAGE_RETRIES
        )
        jobs += page_json["jobs"]
    return jobs

def get_workflow_jobs(wf, all_attempts=False):
    """Get all jobs for a workflow run.

    By default GitHub returns only the latest attempt's jobs. Pass
    all_attempts=True to include jobs from every run attempt: when a run is
    re-run, shards that already passed are carried over (not re-executed) and
    their test-report artifacts keep the job ID from the attempt that produced
    them, so artifact matching by job ID must consider all attempts.
    """
    if wf is None:
        raise Exception("wf is None!")
    for attempt, page_size in enumerate(JOBS_PAGE_SIZES):
        try:
            jobs = _fetch_all_jobs(wf['jobs_url'], page_size, all_attempts)
            break
        except Exception as error:
            if attempt == len(JOBS_PAGE_SIZES) - 1:
                raise
            print(f"  WARNING: {error}; retrying with per_page="
                  f"{JOBS_PAGE_SIZES[attempt + 1]}")
    # Record variant (rerun_disabled_tests / mem_leak_check) job IDs so their
    # near-empty artifacts can be excluded from the S3 download below.
    for j in jobs:
        if _is_variant_job(j.get('name', '')):
            variant_job_ids.add(str(j['id']))
    return jobs

def _modal_shard_total(names, job_prefix, test_config):
    """Parse shard totals out of a list of job/check-run names of the form
    '<job_prefix> / <kind> (<config>, <idx>, <total>, ...)' and return the most
    common <total>, or None when nothing matches."""
    pat = re.compile(
        re.escape(job_prefix) + r" / \S+ \(" + re.escape(test_config) + r", \d+, (\d+)"
    )
    totals = {}
    for name in names:
        if _is_variant_job(name):
            continue
        m = pat.search(name)
        if m:
            total = int(m.group(1))
            totals[total] = totals.get(total, 0) + 1
    if not totals:
        return None
    # Most common total wins (guards against a stray reshaped/duplicate job).
    return sorted(totals.items(), key=lambda kv: (-kv[1], -kv[0]))[0][0]

def derive_shard_count(wf, job_prefix, test_config, fallback):
    """Return the shard total upstream actually used for this (job_prefix,
    test_config), parsed from job names like
    '<job_prefix> / test (<config>, <idx>, <total>, ...)' -> <total>.

    Shard counts differ between an arch's primary workflow and its fallback
    (e.g. mi200 default is 6 shards in rocm-mi200 but 10 in the
    trunk-rocm-sandbox fallback), and upstream reshards without notice (CUDA
    default 5 -> 14, mi300 default 6 -> 8, mi300 inductor 2 -> 4), so we read
    the real total from the resolved run instead of assuming the config value -
    otherwise the constructed "(default, i, 6)" keys miss the actual
    "(default, i, 8)" jobs and nothing downloads.

    Two sources are consulted, in order:
      1. the run's jobs API (surfaces CUDA test jobs directly), then
      2. this run's check-runs - the ROCm arch workflows run their sharded test
         jobs inside a reusable workflow (workflow_call), and those shards are
         NOT always returned by the jobs API but ARE returned by check-runs.
    Both sources are scoped to `wf`: sibling workflows on the same SHA publish
    identically named shards, and borrowing a total from one of those would make
    every constructed artifact prefix miss.
    Falls back to `fallback` only when neither source has a matching job.
    """
    try:
        jobs = get_workflow_jobs(wf)
    except Exception:
        jobs = []
    total = _modal_shard_total(
        (j.get("name", "") for j in jobs), job_prefix, test_config
    )
    if total is not None:
        return total
    # ROCm reusable-workflow shards only show up in check-runs.
    sha = wf.get("head_sha") if isinstance(wf, dict) else None
    if sha:
        try:
            check_runs = get_check_runs_for_run(sha, wf.get("id"), job_prefix)
        except Exception:
            check_runs = []
        total = _modal_shard_total(
            (cr.get("name", "") for cr in check_runs), job_prefix, test_config
        )
        if total is not None:
            return total
    return fallback

def _candidate_job_prefixes(names, test_config):
    """Map each distinct '<prefix>' -> count from names shaped like
    '<prefix> / <kind> (<test_config>, <idx>, <total>, ...)'."""
    pat = re.compile(r"^(.+?) / \S+ \(" + re.escape(test_config) + r", \d+, \d+")
    out = {}
    for name in names:
        m = pat.match(name)
        if m:
            out[m.group(1)] = out.get(m.group(1), 0) + 1
    return out

def _hardware_token(prefix):
    """Return the accelerator family named by a job prefix, if any."""
    m = re.search(r"(mi\d+|navi\d+|gfx\w+|cuda)", prefix.lower())
    return m.group(1) if m else None

def resolve_job_prefix(wf, test_config, configured_prefix):
    """Return the '<prefix>' upstream actually uses for this arch's
    <test_config> test jobs, so a drifted configured prefix self-heals instead
    of silently matching nothing.

    The job-name prefix in parity_job_config.json drifts whenever upstream
    bumps the OS/python/compiler or renames a runner tag (e.g. the Preview
    'gfx942' -> 'mi350' rename, or py3.10 -> py3.12), which used to require a
    manual config edit each time. Candidates come from `wf` only - its jobs API
    plus its own check-runs (ROCm arch shards run in a reusable workflow, so
    they only appear in check-runs). Scoping matters: a commit-wide candidate
    list would offer prefixes that exist solely in a sibling workflow, and
    adopting one of those silently points log and shard matching at a run we
    never download from. If the configured prefix is present we keep it
    unchanged; otherwise we pick the candidate most similar to it within the
    same accelerator family. If nothing matches we return the configured value
    untouched.
    """
    names = []
    try:
        names += [j.get("name", "") for j in get_workflow_jobs(wf)]
    except Exception:
        pass
    sha = wf.get("head_sha") if isinstance(wf, dict) else None
    if sha:
        try:
            names += [
                cr.get("name", "")
                for cr in get_check_runs_for_run(sha, wf.get("id"), "")
            ]
        except Exception:
            pass
    candidates = _candidate_job_prefixes(names, test_config)
    if not candidates or configured_prefix in candidates:
        return configured_prefix
    hardware = _hardware_token(configured_prefix)
    if hardware:
        candidates = {
            prefix: count for prefix, count in candidates.items()
            if _hardware_token(prefix) == hardware
        }
        if not candidates:
            print(f"NOTE: no upstream '{test_config}' job prefix found for "
                  f"'{hardware}'; keeping configured '{configured_prefix}'")
            return configured_prefix
    import difflib
    best = max(
        candidates,
        key=lambda p: (
            difflib.SequenceMatcher(None, p, configured_prefix).ratio(),
            candidates[p],
        ),
    )
    print(f"NOTE: configured job prefix '{configured_prefix}' not found for "
          f"'{test_config}'; using detected prefix '{best}'")
    return best

def get_check_runs_for_commit(sha, prefix):
    """Get check runs for a commit filtered by name prefix.

    The workflow jobs API does not return jobs from reusable workflows
    (workflow_call). The check-runs API returns all jobs regardless of
    workflow nesting, so we use it as a fallback.
    """
    check_runs = []
    page = 1
    while True:
        response = requests.get(
            f"https://api.github.com/repos/pytorch/pytorch/commits/{sha}/check-runs",
            headers=authentication_headers,
            params={'per_page': 100, 'page': page},
        )
        data = response.json()
        runs = data.get('check_runs', [])
        check_runs.extend([cr for cr in runs if prefix in cr.get('name', '')])
        if len(runs) < 100:
            break
        page += 1
    return check_runs

def get_check_runs_for_run(sha, run_id, prefix):
    """Like get_check_runs_for_commit, but restricted to one workflow run.

    The check-runs API is commit-scoped, so a single SHA returns identically
    named shards from every workflow that ran it (trunk, trunk-rocm-sandbox and
    rocm-preview all publish 'linux-noble-rocm-py3.11-mi350 / test (default, ...'
    check-runs). Deciding a run's job prefix or shard total from that mixture is
    how artifacts previously got attributed to the wrong workflow, so callers
    reasoning about a specific run must filter on the run id embedded in
    details_url.
    """
    marker = f"/runs/{run_id}/"
    return [
        cr for cr in get_check_runs_for_commit(sha, prefix)
        if marker in (cr.get("details_url") or "")
    ]

